<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CoreventApp.ViewModels"
             xmlns:models="clr-namespace:CoreventApp.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="CoreventApp.Views.PanelCollaborator"
             x:Name="ThisPage"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             x:DataType="vm:PanelCollaboratorViewModel"
             Title="Meus Trabalhos"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource background_color}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing"
                                        BindingContext="{Binding Source={x:Reference ThisPage}, Path=BindingContext}"
                                        Command="{Binding LoadCommand}" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto, Auto, Auto, *">
        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto, *, Auto"
              Padding="16,14,16,10"
              VerticalOptions="Center">
            <Border Style="{StaticResource BackButtonContainer}">
                <mi:MauiIcon Icon="{mi:Cupertino ArrowLeft}"
                        Style="{StaticResource BackIcon}"/>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                </Border.GestureRecognizers>
            </Border>

            <Label Grid.Column="1"
                   Text="Meus Trabalhos"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{StaticResource primary_text_color}"
                   VerticalOptions="Center"
                   Margin="12,0,0,0"/>
        </Grid>

        <!-- Invitations Banner -->
        <Border Grid.Row="1"
                Margin="16,0,16,10"
                Padding="14"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 14"
                BackgroundColor="#FFF7ED"
                IsVisible="{Binding HasPendingInvites}">
            <Grid ColumnDefinitions="Auto, *, Auto"
                  ColumnSpacing="12">
                <Border WidthRequest="40"
                        HeightRequest="40"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="#FED7AA"
                        VerticalOptions="Center">
                    <mi:MauiIcon Icon="{mi:Cupertino Envelope}"
                                 IconSize="18"
                                 IconColor="#EA580C"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"/>
                </Border>
                <VerticalStackLayout Grid.Column="1"
                                     VerticalOptions="Center"
                                     Spacing="2">
                    <Label FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#9A3412">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Você tem "/>
                                <Span Text="{Binding PendingInvitesCount}"
                                      FontAttributes="Bold"/>
                                <Span Text=" convite(s) pendente(s)"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Text="Toque para ver"
                           FontSize="11"
                           TextColor="#C2410C"/>
                </VerticalStackLayout>
                <mi:MauiIcon Grid.Column="2"
                             Icon="{mi:Cupertino ChevronRight}"
                             IconSize="16"
                             IconColor="#C2410C"
                             VerticalOptions="Center"/>
            </Grid>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenInvitationsCommand}"/>
            </Border.GestureRecognizers>
        </Border>

        <!-- Toggle Abas: Agenda | Histórico -->
        <Border Grid.Row="2"
                Margin="16,10,16,20"
                Padding="4"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 30"
                BackgroundColor="{StaticResource Gray100}">
            <Grid ColumnDefinitions="*, *"
                    ColumnSpacing="0">
                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 26">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border"
                                Binding="{Binding IsAgendaVisible}"
                                Value="True">
                            <Setter Property="BackgroundColor"
                                    Value="{StaticResource toggle_active_bg}"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Border"
                                Binding="{Binding IsAgendaVisible}"
                                Value="False">
                            <Setter Property="BackgroundColor"
                                    Value="Transparent"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Text="Agenda"
                            HorizontalOptions="Center"
                            Padding="0,10"
                            FontAttributes="Bold"
                            FontSize="14">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                    Binding="{Binding IsAgendaVisible}"
                                    Value="True">
                                <Setter Property="TextColor"
                                        Value="{StaticResource White}"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Label"
                                    Binding="{Binding IsAgendaVisible}"
                                    Value="False">
                                <Setter Property="TextColor"
                                        Value="{StaticResource secondary_text_color}"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectAgendaCommand}"/>
                    </Border.GestureRecognizers>
                </Border>

                <Border Grid.Column="1"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 26">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border"
                                Binding="{Binding IsHistoricoVisible}"
                                Value="True">
                            <Setter Property="BackgroundColor"
                                    Value="{StaticResource toggle_active_bg}"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Border"
                                Binding="{Binding IsHistoricoVisible}"
                                Value="False">
                            <Setter Property="BackgroundColor"
                                    Value="Transparent"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Text="Histórico"
                            HorizontalOptions="Center"
                            Padding="0,10"
                            FontAttributes="Bold"
                            FontSize="14">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                    Binding="{Binding IsHistoricoVisible}"
                                    Value="True">
                                <Setter Property="TextColor"
                                        Value="{StaticResource White}"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Label"
                                    Binding="{Binding IsHistoricoVisible}"
                                    Value="False">
                                <Setter Property="TextColor"
                                        Value="{StaticResource secondary_text_color}"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectHistoricoCommand}"/>
                    </Border.GestureRecognizers>
                </Border>
            </Grid>
        </Border>

        <!-- Conteúdo -->
        <ScrollView Grid.Row="3">
            <Grid>
                <!-- ===== AGENDA ===== -->
                <VerticalStackLayout IsVisible="{Binding IsAgendaVisible}"
                        Padding="16,0,16,20"
                        Spacing="20">

                    <!-- SEÇÃO HOJE -->
                    <VerticalStackLayout Spacing="12"
                            IsVisible="{Binding HasEventsToday}">
                        <Label Text="HOJE"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource secondary_text_color}"
                               Margin="4,0,0,0"/>

                        <VerticalStackLayout Spacing="12"
                                             BindableLayout.ItemsSource="{Binding EventsToday}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:CollaboratorEvent">
                                    <Border Stroke="{StaticResource Gray100}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 20"
                                            BackgroundColor="{StaticResource White}"
                                            Padding="16">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.OpenEventDetailCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="16">
                                            <Grid ColumnDefinitions="72, *, 24"
                                                    ColumnSpacing="12">
                                                <Border StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 14"
                                                        HeightRequest="72"
                                                        WidthRequest="72">
                                                    <Image Source="{Binding ImageUrl}"
                                                           Aspect="AspectFill"/>
                                                </Border>

                                                <VerticalStackLayout Grid.Column="1"
                                                        Spacing="4"
                                                        VerticalOptions="Center">
                                                    <Label Text="{Binding Title}"
                                                           FontSize="16"
                                                           FontAttributes="Bold"
                                                           TextColor="{StaticResource primary_text_color}"/>

                                                    <HorizontalStackLayout Spacing="4">
                                                        <mi:MauiIcon Icon="{mi:Cupertino CircleFill}"
                                                                IconSize="10"
                                                                IconColor="{StaticResource icon_default_color}"
                                                                VerticalOptions="Center"/>
                                                        <Label Text="{Binding Date}"
                                                               FontSize="13"
                                                               TextColor="{StaticResource secondary_text_color}"
                                                               VerticalOptions="Center"/>
                                                    </HorizontalStackLayout>

                                                    <Border HorizontalOptions="Start"
                                                            BackgroundColor="{Binding RoleColor}"
                                                            StrokeThickness="0"
                                                            StrokeShape="RoundRectangle 10"
                                                            Padding="8,4"
                                                            Margin="0,4,0,0">
                                                        <Label Text="{Binding Role}"
                                                               FontSize="10"
                                                               FontAttributes="Bold"
                                                               TextColor="{Binding RoleTextColor}"/>
                                                    </Border>
                                                </VerticalStackLayout>

                                                <mi:MauiIcon Grid.Column="2"
                                                             Icon="{mi:Cupertino ChevronRight}"
                                                             IconSize="16"
                                                             IconColor="{StaticResource Gray200}"
                                                             VerticalOptions="Start"
                                                             HorizontalOptions="End"/>
                                            </Grid>

                                            <Border StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 12"
                                                    BackgroundColor="#111827"
                                                    Padding="0,14"
                                                    IsVisible="{Binding HasActionButton}">
                                                <HorizontalStackLayout HorizontalOptions="Center"
                                                        Spacing="8">
                                                    <mi:MauiIcon Icon="{mi:Cupertino Qrcode}"
                                                                 IconSize="16"
                                                                 IconColor="{StaticResource White}"
                                                                 VerticalOptions="Center"/>
                                                    <Label Text="Realizar Credenciamento"
                                                           TextColor="{StaticResource White}"
                                                           FontAttributes="Bold"
                                                           FontSize="14"
                                                           VerticalOptions="Center"/>
                                                </HorizontalStackLayout>
                                            </Border>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- SEÇÃO PRÓXIMOS TRABALHOS -->
                    <VerticalStackLayout Spacing="12"
                            IsVisible="{Binding HasUpcomingEvents}">
                        <Label Text="PRÓXIMOS TRABALHOS"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource secondary_text_color}"
                               Margin="4,0,0,0"/>

                        <VerticalStackLayout Spacing="12"
                                             BindableLayout.ItemsSource="{Binding UpcomingEvents}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:CollaboratorEvent">
                                    <Border Stroke="{StaticResource Gray100}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 20"
                                            BackgroundColor="{StaticResource White}"
                                            Padding="16">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.OpenEventDetailCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="72, *, 24"
                                                ColumnSpacing="12">
                                            <Border StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 14"
                                                    HeightRequest="72"
                                                    WidthRequest="72">
                                                <Image Source="{Binding ImageUrl}"
                                                       Aspect="AspectFill"/>
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1"
                                                    Spacing="4"
                                                    VerticalOptions="Center">
                                                <Label Text="{Binding Title}"
                                                       FontSize="16"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource primary_text_color}"/>

                                                <Label Text="{Binding Date}"
                                                       FontSize="13"
                                                       TextColor="{StaticResource secondary_text_color}"/>

                                                <Border HorizontalOptions="Start"
                                                        BackgroundColor="{Binding RoleColor}"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 10"
                                                        Padding="8,4"
                                                        Margin="0,4,0,0">
                                                    <Label Text="{Binding Role}"
                                                           FontSize="10"
                                                           FontAttributes="Bold"
                                                           TextColor="{Binding RoleTextColor}"/>
                                                </Border>
                                            </VerticalStackLayout>

                                            <Label Grid.Column="2"
                                                   Text="&gt;"
                                                   FontSize="16"
                                                   TextColor="{StaticResource Gray200}"
                                                   VerticalOptions="Start"
                                                   HorizontalOptions="End"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- ===== HISTÓRICO ===== -->
                <VerticalStackLayout IsVisible="{Binding IsHistoricoVisible}"
                        Padding="16,0,16,20"
                        Spacing="12">
                    <Label Text="EVENTOS PASSADOS"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource secondary_text_color}"
                           Margin="4,0,0,0"
                           IsVisible="{Binding HasPastEvents}"/>

                    <VerticalStackLayout Spacing="12"
                                         BindableLayout.ItemsSource="{Binding PastEvents}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:CollaboratorEvent">
                                <Border Stroke="{StaticResource Gray100}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 20"
                                        BackgroundColor="{StaticResource White}"
                                        Padding="16"
                                        Opacity="0.65">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.OpenEventDetailCommand}"
                                                CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="72, *, 24"
                                            ColumnSpacing="12">
                                        <Border StrokeThickness="0"
                                                StrokeShape="RoundRectangle 14"
                                                HeightRequest="72"
                                                WidthRequest="72">
                                            <Image Source="{Binding ImageUrl}"
                                                   Aspect="AspectFill"/>
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1"
                                                Spacing="4"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding Title}"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource secondary_text_color}"/>

                                            <Label Text="{Binding Date}"
                                                   FontSize="13"
                                                   TextColor="{StaticResource secondary_text_color}"/>

                                            <Border HorizontalOptions="Start"
                                                    BackgroundColor="{Binding RoleColor}"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 10"
                                                    Padding="8,4"
                                                    Margin="0,4,0,0">
                                                <Label Text="{Binding Role}"
                                                       FontSize="10"
                                                       FontAttributes="Bold"
                                                       TextColor="{Binding RoleTextColor}"/>
                                            </Border>
                                        </VerticalStackLayout>

                                        <Label Grid.Column="2"
                                               Text="&gt;"
                                               FontSize="16"
                                               TextColor="{StaticResource Gray200}"
                                               VerticalOptions="Start"
                                               HorizontalOptions="End"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
