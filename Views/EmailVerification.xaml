<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
              xmlns:ViewModel="clr-namespace:CoreventApp.ViewModels"
              xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
              x:Class="CoreventApp.Views.EmailVerification"
              x:DataType="ViewModel:EmailVerificationViewModel"
              Title="EmailVerification">

    <Grid RowDefinitions="Auto, *, Auto"
          Padding="20"
          BackgroundColor="{StaticResource background_color}">

        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto"
              VerticalOptions="Center">
            <Border Style="{StaticResource BackButtonContainer}">
                <mi:MauiIcon Icon="{mi:Cupertino ArrowLeft}" Style="{StaticResource BackIcon}">
                    <mi:MauiIcon.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                    </mi:MauiIcon.GestureRecognizers>
                </mi:MauiIcon>
            </Border>

            <Image Grid.Column="1"
                   Source="logo_corevent_full.png"
                   HeightRequest="20"
                   HorizontalOptions="Center"
                   Aspect="AspectFit"
                   SemanticProperties.Description="Corevent Logo"/>
        </Grid>

        <!-- Content -->
        <VerticalStackLayout Grid.Row="1"
                             VerticalOptions="Center"
                             Spacing="16"
                             Margin="0,40,0,0">

            <!-- Icon -->
            <Border StrokeShape="RoundRectangle 40"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource home_highlight_bg}"
                    HeightRequest="80"
                    WidthRequest="80"
                    HorizontalOptions="Center">
                <mi:MauiIcon Icon="{mi:Cupertino Envelope}"
                             IconSize="36"
                             IconColor="{StaticResource primary_orange_color}"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"/>
            </Border>

            <!-- Title -->
            <Label Text="Verifique seu e-mail"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   TextColor="{StaticResource primary_text_color}"/>

            <!-- Subtitle -->
            <Label LineBreakMode="WordWrap"
                   HorizontalTextAlignment="Center"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource secondary_text_color}">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Enviamos um código de verificação para "/>
                        <Span Text="{Binding Email}"
                              FontAttributes="Bold"
                              TextColor="{StaticResource primary_text_color}"/>
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <!-- Code Entry -->
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="{StaticResource Gray200}"
                    StrokeThickness="1"
                    BackgroundColor="{StaticResource input_color}"
                    Margin="20,8"
                    Padding="4">
                <Entry Text="{Binding Code}"
                       Placeholder="000000"
                       MaxLength="6"
                       Keyboard="Numeric"
                       HorizontalTextAlignment="Center"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="{StaticResource input_text}"
                       BackgroundColor="Transparent"
                       HorizontalOptions="Fill"/>
            </Border>

            <!-- Code hint -->
            <Label Text="Digite os 6 dígitos recebidos no e-mail"
                   FontSize="13"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   TextColor="{StaticResource Gray400}"/>

            <!-- Error message -->
            <Label Text="{Binding ErrorMessage}"
                   IsVisible="{Binding IsError}"
                   TextColor="{StaticResource error_color}"
                   FontSize="14"
                   HorizontalTextAlignment="Center"
                   HorizontalOptions="Center"/>

            <!-- Loading indicator -->
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Color="{StaticResource primary_orange_color}"
                               HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <!-- Bottom actions -->
        <VerticalStackLayout Grid.Row="2"
                             VerticalOptions="End"
                             Spacing="16"
                             Margin="0,0,0,20">

            <Button Text="Verificar"
                    TextColor="{StaticResource White}"
                    FontAttributes="Bold"
                    Background="{StaticResource gradient_button}"
                    Command="{Binding VerifyCommand}"/>

            <Label Text="{Binding ResendText}"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource primary_orange_color}"
                   FontAttributes="Bold"
                   FontSize="14">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ResendCommand}"/>
                </Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
