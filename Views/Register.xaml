<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
              xmlns:ViewModel="clr-namespace:CoreventApp.ViewModels"
              x:Class="CoreventApp.Views.Register"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="ViewModel:RegisterViewModel"
             Title="Register">

        <ContentPage.Resources>
               <ResourceDictionary>
                      <Style x:Key="InvalidEntryStyle" TargetType="Entry">
                             <Setter Property="TextColor" Value="{StaticResource error_color}" />
                      </Style>
                      <toolkit:CompareConverter x:Key="IsStep1" ComparisonOperator="Equal">
                             <toolkit:CompareConverter.ComparingValue>
                                    <x:Int32>1</x:Int32>
                             </toolkit:CompareConverter.ComparingValue>
                      </toolkit:CompareConverter>
                      <toolkit:CompareConverter x:Key="IsStep2" ComparisonOperator="Equal">
                             <toolkit:CompareConverter.ComparingValue>
                                    <x:Int32>2</x:Int32>
                             </toolkit:CompareConverter.ComparingValue>
                      </toolkit:CompareConverter>
                      <toolkit:CompareConverter x:Key="IsStep3" ComparisonOperator="Equal">
                             <toolkit:CompareConverter.ComparingValue>
                                    <x:Int32>3</x:Int32>
                             </toolkit:CompareConverter.ComparingValue>
                      </toolkit:CompareConverter>
                      <toolkit:CompareConverter x:Key="IsStep4" ComparisonOperator="Equal">
                             <toolkit:CompareConverter.ComparingValue>
                                    <x:Int32>4</x:Int32>
                             </toolkit:CompareConverter.ComparingValue>
                      </toolkit:CompareConverter>
               </ResourceDictionary>
        </ContentPage.Resources>

       <Grid RowDefinitions="Auto, Auto, Auto, *, Auto"
             Padding="20"
             BackgroundColor="{StaticResource background_color}">

              <!-- Header -->
              <Grid Grid.Row="0"
                    ColumnDefinitions="Auto,*,Auto"
                    VerticalOptions="Center">
                     <Border Style="{StaticResource BackButtonContainer}">
                            <mi:MauiIcon Icon="{mi:Cupertino ArrowLeft}"
                                         Style="{StaticResource BackIcon}">
                                   <mi:MauiIcon.GestureRecognizers>
                                          <TapGestureRecognizer Command="{Binding HeaderBackCommand}"/>
                                   </mi:MauiIcon.GestureRecognizers>
                            </mi:MauiIcon>
                     </Border>

                     <Image Grid.Column="1"
                            Source="logo_corevent_full.png"
                            HeightRequest="20"
                            HorizontalOptions="Center"
                            Aspect="AspectFit"
                            SemanticProperties.Description="Corevent Logo"/>
              </Grid>

              <!-- Progress Bar -->
              <ProgressBar x:Name="MainProgressBar"
                           Grid.Row="1"
                           Margin="0,20,0,30"
                           Progress="{Binding Progress}"
                           HeightRequest="8"
                           BackgroundColor="{StaticResource Gray100}"
                           ProgressColor="{StaticResource primary_orange_color}"/>

              <VerticalStackLayout Grid.Row="2"
                                   Margin="0,0,0,6"
                                   Spacing="5">
                     <Label x:Name="StepTitle"
                            Text="{Binding StepTitle}"
                            FontSize="22"
                            LineBreakMode="WordWrap"
                            FontAttributes="Bold"
                            VerticalOptions="Center"
                            HorizontalOptions="Start"
                            TextColor="{StaticResource primary_text_color}"/>
                     <Label x:Name="StepDescription"
                            Text="{Binding StepDescription}"
                            VerticalOptions="Center"
                            HorizontalOptions="Start"
                            LineBreakMode="WordWrap"
                            TextColor="{StaticResource secondary_text_color}"/>
              </VerticalStackLayout>

              <Grid Grid.Row="3"
                    Margin="0,4,0,0">

                     <!-- Step 1: Nome + Data de Nascimento -->
                     <VerticalStackLayout x:Name="Step1"
                                           IsVisible="{Binding CurrentStep, Converter={StaticResource IsStep1}}">
                            <Grid RowDefinitions="Auto, Auto, Auto, Auto">
                                   <Label Grid.Row="0"
                                          Text="Nome completo"
                                          TextColor="{StaticResource primary_text_color}"/>
                                   <Border Grid.Row="1"
                                           Stroke="{StaticResource Gray200}"
                                           StrokeThickness="1"
                                           StrokeShape="RoundRectangle 12"
                                           BackgroundColor="{StaticResource input_color}"
                                           Padding="12,0"
                                           HeightRequest="50">
                                          <Entry x:Name="EntryNome"
                                                 Text="{Binding Form.Nome}"
                                                 Placeholder="Seu nome completo"
                                                 VerticalOptions="Center"
                                                 TextColor="{StaticResource input_text}"
                                                 BackgroundColor="Transparent"/>
                                   </Border>

                                   <Label Grid.Row="2"
                                          Margin="0,20,0,0"
                                          Text="Data de nascimento"
                                          TextColor="{StaticResource primary_text_color}"/>
                                   <DatePicker Grid.Row="3"
                                               x:Name="DateNascimento"
                                               Date="{Binding Form.DataNascimento}"
                                               MaximumDate="{Binding DataNascimentoMax}"
                                               Format="dd/MM/yyyy"
                                               TextColor="{StaticResource primary_text_color}"
                                               BackgroundColor="{StaticResource input_color}"/>
                            </Grid>
                     </VerticalStackLayout>

                     <!-- Step 2: Pessoa Física ou Jurídica -->
                     <VerticalStackLayout x:Name="Step2"
                                           IsVisible="{Binding CurrentStep, Converter={StaticResource IsStep2}}"
                                          Spacing="16">
                            <!-- PF Card -->
                            <Grid HeightRequest="80"
                                  BackgroundColor="Transparent">
                                   <Grid.GestureRecognizers>
                                          <TapGestureRecognizer Command="{Binding SelectAccountTypeCommand}"
                                                                CommandParameter="pf"/>
                                   </Grid.GestureRecognizers>
                                   <Border Stroke="{StaticResource Gray200}"
                                           StrokeThickness="1"
                                           StrokeShape="RoundRectangle 16"
                                           BackgroundColor="{StaticResource White}"
                                           Padding="20">
                                          <Grid ColumnDefinitions="Auto, *"
                                                VerticalOptions="Center">
                                                 <Border WidthRequest="48"
                                                         HeightRequest="48"
                                                         StrokeShape="RoundRectangle 24"
                                                         BackgroundColor="#FFF3E0"
                                                         Stroke="Transparent"
                                                         VerticalOptions="Center">
                                                        <mi:MauiIcon Icon="{mi:Cupertino Person}"
                                                                     IconSize="24"
                                                                     IconColor="{StaticResource primary_orange_color}"
                                                                     HorizontalOptions="Center"
                                                                     VerticalOptions="Center"/>
                                                 </Border>
                                                 <VerticalStackLayout Grid.Column="1"
                                                                      VerticalOptions="Center"
                                                                      Margin="14,0,0,0">
                                                        <Label Text="Pessoa Física"
                                                               FontSize="16"
                                                               FontAttributes="Bold"
                                                               TextColor="{StaticResource primary_text_color}"/>
                                                        <Label Text="Usar CPF"
                                                               FontSize="13"
                                                               TextColor="{StaticResource secondary_text_color}"/>
                                                 </VerticalStackLayout>
                                          </Grid>
                                   </Border>
                            </Grid>

                            <!-- PJ Card -->
                            <Grid HeightRequest="80"
                                  BackgroundColor="Transparent">
                                   <Grid.GestureRecognizers>
                                          <TapGestureRecognizer Command="{Binding SelectAccountTypeCommand}"
                                                                CommandParameter="pj"/>
                                   </Grid.GestureRecognizers>
                                   <Border Stroke="{StaticResource Gray200}"
                                           StrokeThickness="1"
                                           StrokeShape="RoundRectangle 16"
                                           BackgroundColor="{StaticResource White}"
                                           Padding="20">
                                          <Grid ColumnDefinitions="Auto, *"
                                                VerticalOptions="Center">
                                                 <Border WidthRequest="48"
                                                         HeightRequest="48"
                                                         StrokeShape="RoundRectangle 24"
                                                         BackgroundColor="#E8F5E9"
                                                         Stroke="Transparent"
                                                         VerticalOptions="Center">
                                                        <mi:MauiIcon Icon="{mi:Cupertino Building}"
                                                                     IconSize="24"
                                                                     IconColor="#4CAF50"
                                                                     HorizontalOptions="Center"
                                                                     VerticalOptions="Center"/>
                                                 </Border>
                                                 <VerticalStackLayout Grid.Column="1"
                                                                      VerticalOptions="Center"
                                                                      Margin="14,0,0,0">
                                                        <Label Text="Pessoa Jurídica"
                                                               FontSize="16"
                                                               FontAttributes="Bold"
                                                               TextColor="{StaticResource primary_text_color}"/>
                                                        <Label Text="Usar CNPJ"
                                                               FontSize="13"
                                                               TextColor="{StaticResource secondary_text_color}"/>
                                                 </VerticalStackLayout>
                                          </Grid>
                                   </Border>
                            </Grid>
                     </VerticalStackLayout>

                     <!-- Step 3: Documento (CPF ou CNPJ) -->
                     <VerticalStackLayout x:Name="Step3"
                                           IsVisible="{Binding CurrentStep, Converter={StaticResource IsStep3}}"
                                          Spacing="6">
                            <Label Text="Documento"
                                   TextColor="{StaticResource primary_text_color}"/>

                            <!-- CPF Entry -->
                            <Border Stroke="{StaticResource Gray200}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{StaticResource input_color}"
                                    Padding="12,0"
                                    HeightRequest="50"
                                    IsVisible="{Binding Form.IsPessoaFisica}">
                                   <Entry x:Name="EntryCpf"
                                          Text="{Binding Form.Cpf}"
                                          Placeholder="000.000.000-00"
                                          VerticalOptions="Center"
                                          TextColor="{StaticResource input_text}"
                                          BackgroundColor="Transparent">
                                          <Entry.Behaviors>
                                                 <toolkit:MaskedBehavior Mask="XXX.XXX.XXX-XX"
                                                                         UnmaskedCharacter="X"/>
                                          </Entry.Behaviors>
                                   </Entry>
                            </Border>

                            <!-- CNPJ Entry -->
                            <Border Stroke="{StaticResource Gray200}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{StaticResource input_color}"
                                    Padding="12,0"
                                    HeightRequest="50"
                                    IsVisible="{Binding Form.IsPessoaJuridica}">
                                   <Entry x:Name="EntryCnpj"
                                          Text="{Binding Form.Cnpj}"
                                          Placeholder="00.000.000/0001-00"
                                          VerticalOptions="Center"
                                          TextColor="{StaticResource input_text}"
                                          BackgroundColor="Transparent">
                                          <Entry.Behaviors>
                                                 <toolkit:MaskedBehavior Mask="XX.XXX.XXX/XXXX-XX"
                                                                         UnmaskedCharacter="X"/>
                                          </Entry.Behaviors>
                                   </Entry>
                            </Border>
                     </VerticalStackLayout>

                     <!-- Step 4: Credenciais -->
                     <VerticalStackLayout x:Name="Step4"
                                           IsVisible="{Binding CurrentStep, Converter={StaticResource IsStep4}}">
                            <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto">
                                   <Label Grid.Row="0"
                                          Text="E-mail"
                                          TextColor="{StaticResource primary_text_color}"/>
                                   <Border Grid.Row="1"
                                           Stroke="{StaticResource Gray200}"
                                           StrokeThickness="1"
                                           StrokeShape="RoundRectangle 12"
                                           BackgroundColor="{StaticResource input_color}"
                                           Padding="12,0"
                                           HeightRequest="50">
                                          <Entry x:Name="EntryEmail"
                                                 Text="{Binding Form.Email}"
                                                 Placeholder="seu@email.com"
                                                 Keyboard="Email"
                                                 VerticalOptions="Center"
                                                 TextColor="{StaticResource input_text}"
                                                 BackgroundColor="Transparent">
                                                 <Entry.Behaviors>
                                                        <toolkit:EmailValidationBehavior Flags="ValidateOnValueChanged"
                                                                                         InvalidStyle="{StaticResource InvalidEntryStyle}" />
                                                 </Entry.Behaviors>
                                          </Entry>
                                   </Border>

                                   <Label Grid.Row="2"
                                          Margin="0,20,0,0"
                                          Text="Senha"
                                          TextColor="{StaticResource primary_text_color}"/>
                                   <Border Grid.Row="3"
                                           Stroke="{StaticResource Gray200}"
                                           StrokeThickness="1"
                                           StrokeShape="RoundRectangle 12"
                                           BackgroundColor="{StaticResource input_color}"
                                           Padding="12,0"
                                           HeightRequest="50">
                                          <Entry x:Name="EntrySenha"
                                                 Text="{Binding Form.Senha}"
                                                 Placeholder="Mínimo 8 caracteres"
                                                 IsPassword="True"
                                                 VerticalOptions="Center"
                                                 TextColor="{StaticResource input_text}"
                                                 BackgroundColor="Transparent"/>
                                   </Border>

                                   <Label Grid.Row="4"
                                          Margin="0,20,0,0"
                                          Text="Confirmar senha"
                                          TextColor="{StaticResource primary_text_color}"/>
                                   <Border Grid.Row="5"
                                           Stroke="{StaticResource Gray200}"
                                           StrokeThickness="1"
                                           StrokeShape="RoundRectangle 12"
                                           BackgroundColor="{StaticResource input_color}"
                                           Padding="12,0"
                                           HeightRequest="50">
                                          <Entry x:Name="EntryConfirmarSenha"
                                                 Text="{Binding Form.ConfirmarSenha}"
                                                 Placeholder="Repita a senha"
                                                 IsPassword="True"
                                                 VerticalOptions="Center"
                                                 TextColor="{StaticResource input_text}"
                                                 BackgroundColor="Transparent"/>
                                   </Border>
                            </Grid>
                     </VerticalStackLayout>
              </Grid>

              <VerticalStackLayout Grid.Row="4"
                                   VerticalOptions="End"
                                   Spacing="20">
                     <ActivityIndicator IsRunning="{Binding IsBusy}"
                                        IsVisible="{Binding IsBusy}"
                                        Color="{StaticResource primary_orange_color}"
                                        HeightRequest="30"
                                        HorizontalOptions="Center"/>
                     <Button x:Name="BtnNext"
                             Text="{Binding ButtonNextText}"
                             TextColor="{StaticResource White}"
                             FontAttributes="Bold"
                             Background="{StaticResource gradient_button}"
                             Command="{Binding NextCommand}"/>
              </VerticalStackLayout>
       </Grid>
</ContentPage>
