<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:vm="clr-namespace:CoreventApp.ViewModels"
             xmlns:dtos="clr-namespace:CoreventApp.Models.Dtos"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="CoreventApp.Views.Home"
             x:DataType="vm:HomeViewModel"
             x:Name="ThisPage"
             Title="Home"
             BackgroundColor="{StaticResource background_color}">

  <ContentPage.Behaviors>
    <toolkit:EventToCommandBehavior EventName="Appearing"
                                      BindingContext="{Binding Source={x:Reference ThisPage}, Path=BindingContext}"
                                      Command="{Binding LoadCommand}" />
  </ContentPage.Behaviors>

  <Grid Padding="0"
        BackgroundColor="{StaticResource background_color}">
    <ScrollView>
      <VerticalStackLayout Padding="16,14,16,20"
                           Spacing="18">
        <Grid ColumnDefinitions="*, Auto"
              VerticalOptions="Center">
          <Label Text="Home"
                 FontSize="20"
                 FontAttributes="Bold"
                 TextColor="{StaticResource primary_text_color}"
                 VerticalOptions="Center"/>

          <Border Grid.Column="1"
                  WidthRequest="40"
                  HeightRequest="40"
                  Stroke="{StaticResource Gray200}"
                  StrokeThickness="1"
                  StrokeShape="RoundRectangle 20"
                  BackgroundColor="{StaticResource White}"
                  Padding="2">
            <Image Source="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=120&amp;h=120&amp;fit=crop"
                   Aspect="AspectFill"/>
          </Border>
        </Grid>

        <Border Stroke="{StaticResource Gray100}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 18"
                BackgroundColor="{StaticResource White}"
                Padding="12,10">
          <Grid ColumnDefinitions="50,*,36"
                ColumnSpacing="10">
            <Border BackgroundColor="{StaticResource home_highlight_bg}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 14"
                    WidthRequest="50"
                    HeightRequest="50"
                    HorizontalOptions="Start"
                    VerticalOptions="Center">
              <mi:MauiIcon Icon="{mi:Cupertino Search}"
                           IconSize="24"
                           IconColor="{StaticResource icon_default_color}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
            </Border>

            <VerticalStackLayout Grid.Column="1"
                                 Spacing="2"
                                 VerticalOptions="Center">
              <Label Text="O que vamos fazer hoje?"
                     FontAttributes="Bold"
                     FontSize="16"
                     TextColor="{StaticResource primary_text_color}"/>
              <Label Text="Encontre shows, festas e mais..."
                     FontSize="13"
                     TextColor="{StaticResource secondary_text_color}"/>
            </VerticalStackLayout>

            <Border Grid.Column="2"
                    BackgroundColor="{StaticResource card_icon_bg}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    WidthRequest="36"
                    HeightRequest="36"
                    VerticalOptions="Center">
              <mi:MauiIcon Icon="{mi:Cupertino LineHorizontal3Decrease}"
                           Style="{StaticResource SmallIcon}"
                           IconSize="15"
                           IconColor="{StaticResource icon_default_color}"/>
            </Border>
          </Grid>
        </Border>

        <Grid ColumnDefinitions="*,Auto"
              VerticalOptions="Center">
          <Label Text="Destaques"
                 FontSize="20"
                 FontAttributes="Bold"
                 TextColor="{StaticResource primary_text_color}"/>
          <Label Grid.Column="1"
                 Text="Ver todos"
                 FontSize="14"
                 FontAttributes="Bold"
                 TextColor="{StaticResource primary_orange_color}"
                 VerticalOptions="Center"/>
        </Grid>

        <!-- Highlighted Events from API -->
        <ScrollView Orientation="Horizontal">
          <HorizontalStackLayout BindableLayout.ItemsSource="{Binding HighlightedEvents}"
                                 Spacing="12">
            <BindableLayout.ItemTemplate>
              <DataTemplate x:DataType="dtos:EventListItemDto">
                <Border WidthRequest="290"
                        Stroke="{StaticResource Gray100}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="{StaticResource White}">
                  <Border.GestureRecognizers>
                    <TapGestureRecognizer
                      Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectEventCommand}"
                      CommandParameter="{Binding}"/>
                  </Border.GestureRecognizers>
                  <Grid RowDefinitions="178, *, Auto">
                    <Grid>
                      <Image Source="{Binding BannerUrl, TargetNullValue='https://placehold.co/600x400/FF5722/FFFFFF.png?text=Evento'}"
                             Aspect="AspectFill"/>
                      <HorizontalStackLayout Margin="12"
                                             Spacing="6"
                                             HorizontalOptions="Start"
                                             VerticalOptions="End">
                        <Border Padding="12,6"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14"
                                BackgroundColor="{StaticResource primary_orange_color}">
                          <Label Text="{Binding Category, Converter={StaticResource CategoryDisplayConverter}}"
                                 FontSize="12"
                                 FontAttributes="Bold"
                                 TextColor="{StaticResource White}"/>
                        </Border>
                        <Border Padding="12,6"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14"
                                BackgroundColor="#DBEAFE">
                          <Label Text="{Binding LocationType, Converter={StaticResource LocationTypeDisplayConverter}}"
                                 FontSize="12"
                                 FontAttributes="Bold"
                                 TextColor="#2563EB"/>
                        </Border>
                        <Border Padding="12,6"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14"
                                BackgroundColor="#FEE2E2"
                                IsVisible="{Binding IsAdultOnly}">
                          <Label Text="+18"
                                 FontSize="12"
                                 FontAttributes="Bold"
                                 TextColor="#DC2626"/>
                        </Border>
                      </HorizontalStackLayout>
                    </Grid>
                    <VerticalStackLayout Grid.Row="1"
                                         Padding="14,8,14,0"
                                         Spacing="6">
                      <Label Text="{Binding Title}"
                             FontSize="16"
                             FontAttributes="Bold"
                             TextColor="{StaticResource primary_text_color}"
                             LineBreakMode="TailTruncation"/>
                      <HorizontalStackLayout Spacing="4">
                        <mi:MauiIcon Icon="{mi:Cupertino Calendar}"
                                     IconSize="12"
                                     IconColor="{StaticResource icon_default_color}"
                                     VerticalOptions="Center"/>
                        <Label Text="{Binding StartDate, StringFormat='{0:dd MMM, yyyy}'}"
                               FontSize="12"
                               TextColor="{StaticResource secondary_text_color}"
                               VerticalOptions="Center"/>
                        <Label Text="-"
                               FontSize="12"
                               TextColor="{StaticResource secondary_text_color}"
                               VerticalOptions="Center"/>
                        <Label Text="{Binding EndDate, StringFormat='{0:dd MMM, yyyy}'}"
                               FontSize="12"
                               TextColor="{StaticResource secondary_text_color}"
                               VerticalOptions="Center"/>
                      </HorizontalStackLayout>
                      <HorizontalStackLayout Spacing="4">
                        <mi:MauiIcon Icon="{mi:Cupertino MapPin}"
                                     IconSize="12"
                                     IconColor="{StaticResource icon_default_color}"
                                     VerticalOptions="Center"/>
                        <Label Text="{Binding LocationName}"
                               FontSize="12"
                               TextColor="{StaticResource secondary_text_color}"
                               LineBreakMode="TailTruncation"
                               VerticalOptions="Center">
                          <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding LocationType}"
                                         Value="online">
                              <Setter Property="Text" Value="Evento Online"/>
                            </DataTrigger>
                          </Label.Triggers>
                        </Label>
                      </HorizontalStackLayout>
                    </VerticalStackLayout>
                    <HorizontalStackLayout Grid.Row="2"
                                           Padding="14,8,14,12"
                                           Spacing="4">
                      <mi:MauiIcon Icon="{mi:Cupertino Person}"
                                   IconSize="12"
                                   IconColor="{StaticResource icon_default_color}"
                                   VerticalOptions="Center"/>
                      <Label Text="{Binding Organizer.Name}"
                             FontSize="12"
                             TextColor="{StaticResource secondary_text_color}"
                             LineBreakMode="TailTruncation"
                             VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                  </Grid>
                </Border>
              </DataTemplate>
            </BindableLayout.ItemTemplate>
          </HorizontalStackLayout>
        </ScrollView>

        <!-- All Events -->
        <Label Text="Outros Eventos"
               FontSize="20"
               FontAttributes="Bold"
               TextColor="{StaticResource primary_text_color}"/>

        <VerticalStackLayout BindableLayout.ItemsSource="{Binding OtherEvents}"
                             Spacing="12">
          <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="dtos:EventListItemDto">
              <Border Stroke="{StaticResource Gray100}"
                      StrokeThickness="1"
                      StrokeShape="RoundRectangle 20"
                      BackgroundColor="{StaticResource White}">
                <Border.GestureRecognizers>
                  <TapGestureRecognizer
                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectEventCommand}"
                    CommandParameter="{Binding}"/>
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="100, *" Padding="8, 6">
                  <Border WidthRequest="100"
                          HeightRequest="100"
                          StrokeThickness="0"
                          StrokeShape="RoundRectangle 20">
                    <Image Source="{Binding BannerUrl, TargetNullValue='https://placehold.co/200x200/FF5722/FFFFFF.png?text=Evento'}"
                           Aspect="AspectFill"/>
                  </Border>

                  <VerticalStackLayout Grid.Column="1"
                                       Padding="12,6,12,6"
                                       Spacing="2"
                                       VerticalOptions="Center">
                    <Label Text="{Binding Category, Converter={StaticResource CategoryDisplayConverter}}"
                           FontSize="10"
                           FontAttributes="Bold"
                           TextColor="{StaticResource secondary_text_color}"/>

                    <Label Text="{Binding Title}"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="{StaticResource primary_text_color}"
                           LineBreakMode="TailTruncation"/>

                    <HorizontalStackLayout Spacing="4">
                      <mi:MauiIcon Icon="{mi:Cupertino Calendar}"
                                   IconSize="11"
                                   IconColor="{StaticResource icon_default_color}"
                                   VerticalOptions="Center"/>
                      <Label Text="{Binding StartDate, StringFormat='{0:dd MMM, yyyy}'}"
                             FontSize="11"
                             TextColor="{StaticResource secondary_text_color}"
                             VerticalOptions="Center"/>
                      <Label Text="-"
                             FontSize="11"
                             TextColor="{StaticResource secondary_text_color}"
                             VerticalOptions="Center"/>
                      <Label Text="{Binding EndDate, StringFormat='{0:dd MMM, yyyy}'}"
                             FontSize="11"
                             TextColor="{StaticResource secondary_text_color}"
                             VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="4">
                      <mi:MauiIcon Icon="{mi:Cupertino MapPin}"
                                   IconSize="11"
                                   IconColor="{StaticResource icon_default_color}"
                                   VerticalOptions="Center"/>
                      <Label Text="{Binding LocationName}"
                             FontSize="11"
                             TextColor="{StaticResource secondary_text_color}"
                             LineBreakMode="TailTruncation"
                             VerticalOptions="Center">
                        <Label.Triggers>
                          <DataTrigger TargetType="Label"
                                       Binding="{Binding LocationType}"
                                       Value="online">
                            <Setter Property="Text" Value="Evento Online"/>
                          </DataTrigger>
                        </Label.Triggers>
                      </Label>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="4">
                      <mi:MauiIcon Icon="{mi:Cupertino Person}"
                                   IconSize="11"
                                   IconColor="{StaticResource icon_default_color}"
                                   VerticalOptions="Center"/>
                      <Label Text="{Binding Organizer.Name}"
                             FontSize="11"
                             TextColor="{StaticResource secondary_text_color}"
                             LineBreakMode="TailTruncation"
                             VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                  </VerticalStackLayout>
                </Grid>
              </Border>
            </DataTemplate>
          </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
      </VerticalStackLayout>
    </ScrollView>
  </Grid>
</ContentPage>
