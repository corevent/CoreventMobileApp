<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ViewModel="clr-namespace:CoreventApp.ViewModels"
             x:Class="CoreventApp.Views.ForgotPassword"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="ViewModel:ForgotPasswordViewModel"
             Title="ForgotPassword">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="InvalidEntryStyle" TargetType="Entry">
                <Setter Property="TextColor" Value="{StaticResource error_color}" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *, Auto"
          Padding="20"
          BackgroundColor="{StaticResource background_color}"
          HorizontalOptions="Center">

        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto"
              VerticalOptions="Center">
            <mi:MauiIcon Icon="{mi:Cupertino ArrowLeft}"
                         IconSize="22"
                         IconColor="{StaticResource primary_text_color}"
                         HorizontalOptions="Start"
                         VerticalOptions="Center">
                <mi:MauiIcon.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                </mi:MauiIcon.GestureRecognizers>
            </mi:MauiIcon>

            <Image Grid.Column="1"
                   Source="logo_corevent_full.png"
                   HeightRequest="20"
                   HorizontalOptions="Center"
                   Aspect="AspectFit"
                   SemanticProperties.Description="Corevent Logo"/>
        </Grid>

        <!-- Content -->
        <VerticalStackLayout Grid.Row="1"
                             VerticalOptions="Center"
                             Spacing="16">

            <Border StrokeShape="RoundRectangle 40"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource home_highlight_bg}"
                    HeightRequest="80"
                    WidthRequest="80"
                    HorizontalOptions="Center">
                <mi:MauiIcon Icon="{mi:Cupertino Lock}"
                             IconSize="36"
                             IconColor="{StaticResource icon_default_color}"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"/>
            </Border>

            <Label Text="Recuperar senha"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   TextColor="{StaticResource primary_text_color}"/>

            <Label Text="Informe seu e-mail para receber o código de verificação."
                   FontSize="14"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap"
                   TextColor="{StaticResource secondary_text_color}"/>

            <VerticalStackLayout Spacing="6"
                                 Margin="0,8,0,0">
                <Label Text="E-mail"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{StaticResource secondary_text_color}"
                       Margin="4,0"/>
                <Border Stroke="{StaticResource Gray200}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="{StaticResource input_color}"
                        Padding="12,0"
                        HeightRequest="50">
                    <Entry Text="{Binding Email}"
                           Placeholder="seu@email.com"
                           Keyboard="Email"
                           VerticalOptions="Center"
                           TextColor="{StaticResource input_text}"
                           BackgroundColor="Transparent">
                        <Entry.Behaviors>
                            <toolkit:EmailValidationBehavior Flags="ValidateOnValueChanged"
                                                            InvalidStyle="{StaticResource InvalidEntryStyle}" />
                        </Entry.Behaviors>
                    </Entry>
                </Border>
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Color="{StaticResource primary_orange_color}"
                               HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <!-- Bottom -->
        <VerticalStackLayout Grid.Row="2"
                             VerticalOptions="End"
                             Spacing="16"
                             Margin="0,0,0,20">
            <Button Text="Enviar código"
                    TextColor="{StaticResource White}"
                    FontAttributes="Bold"
                    Background="{StaticResource gradient_button}"
                    Command="{Binding SendResetCodeCommand}"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
