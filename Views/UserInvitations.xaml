<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CoreventApp.ViewModels"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="CoreventApp.Views.UserInvitations"
             x:DataType="vm:UserInvitationsViewModel"
             x:Name="ThisPage"
             Title="Convites"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource background_color}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding LoadInvitationsCommand}" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto, *">
        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto, *"
              Padding="16,14,16,10"
              VerticalOptions="Center">
            <Border Style="{StaticResource BackButtonContainer}">
                <mi:MauiIcon Icon="{mi:Cupertino ArrowLeft}"
                             Style="{StaticResource BackIcon}"/>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                </Border.GestureRecognizers>
            </Border>
            <Label Grid.Column="1"
                   Text="Convites"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{StaticResource primary_text_color}"
                   VerticalOptions="Center"
                   Margin="12,0,0,0"/>
        </Grid>

        <!-- Content -->
        <RefreshView Grid.Row="1"
                     Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsRefreshing}">
            <ScrollView>
                <VerticalStackLayout Padding="16,0,16,20"
                                     Spacing="20">

                    <!-- Loading -->
                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       IsVisible="{Binding IsLoading}"
                                       HeightRequest="40"
                                       HorizontalOptions="Center"
                                       Margin="0,40,0,0"/>

                    <!-- Empty state -->
                    <VerticalStackLayout IsVisible="{Binding HasInvitations, Converter={StaticResource InvertedBoolConverter}}"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="12"
                                         Margin="0,60,0,0">
                        <mi:MauiIcon Icon="{mi:Cupertino EnvelopeOpen}"
                                     IconSize="48"
                                     IconColor="{StaticResource Gray200}"
                                     HorizontalOptions="Center"/>
                        <Label Text="Nenhum convite encontrado"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource secondary_text_color}"
                               HorizontalOptions="Center"/>
                        <Label Text="Você não possui convites pendentes no momento."
                               FontSize="13"
                               TextColor="{StaticResource Gray200}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>

                    <!-- Pending Section -->
                    <VerticalStackLayout Spacing="10"
                                         IsVisible="{Binding HasPending}">
                        <Label Text="PENDENTES"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource secondary_text_color}"
                               Margin="4,0,0,0"/>
                        <VerticalStackLayout Spacing="10"
                                             BindableLayout.ItemsSource="{Binding PendingInvitations}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:UserInvitationItem">
                                    <Border Stroke="{StaticResource Gray100}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 14"
                                            BackgroundColor="{StaticResource White}"
                                            Padding="14">
                                        <Grid ColumnDefinitions="44, *, Auto"
                                              ColumnSpacing="12">
                                            <Border WidthRequest="44"
                                                    HeightRequest="44"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 22"
                                                    BackgroundColor="{StaticResource card_icon_bg}"
                                                    VerticalOptions="Center">
                                                <Label Text="{Binding EventInitial}"
                                                       FontSize="18"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource primary_text_color}"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"/>
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1"
                                                                 VerticalOptions="Center"
                                                                 Spacing="2">
                                                <Label Text="{Binding EventName}"
                                                       FontSize="15"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource primary_text_color}"
                                                       LineBreakMode="TailTruncation"/>
                                                <Label FontSize="11"
                                                       TextColor="{StaticResource secondary_text_color}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="Convidado por "/>
                                                            <Span Text="{Binding OrganizerName}"
                                                                  FontAttributes="Bold"/>
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <Border HorizontalOptions="Start"
                                                        BackgroundColor="{Binding RoleColor}"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 8"
                                                        Padding="8,3"
                                                        Margin="0,2,0,0">
                                                    <Label Text="{Binding Role}"
                                                           FontSize="10"
                                                           FontAttributes="Bold"
                                                           TextColor="{Binding RoleTextColor}"/>
                                                </Border>
                                            </VerticalStackLayout>
                                            <HorizontalStackLayout Grid.Column="2"
                                                                   VerticalOptions="Center"
                                                                   Spacing="8">
                                                <Border WidthRequest="40"
                                                        HeightRequest="40"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 20"
                                                        BackgroundColor="#DCFCE7"
                                                        VerticalOptions="Center">
                                                    <mi:MauiIcon Icon="{mi:Cupertino Checkmark}"
                                                                 IconSize="18"
                                                                 IconColor="#16A34A"
                                                                 HorizontalOptions="Center"
                                                                 VerticalOptions="Center"/>
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.AcceptInvitationCommand}"
                                                                              CommandParameter="{Binding .}"/>
                                                    </Border.GestureRecognizers>
                                                </Border>
                                                <Border WidthRequest="40"
                                                        HeightRequest="40"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 20"
                                                        BackgroundColor="#FEE2E2"
                                                        VerticalOptions="Center">
                                                    <mi:MauiIcon Icon="{mi:Cupertino Multiply}"
                                                                 IconSize="18"
                                                                 IconColor="#DC2626"
                                                                 HorizontalOptions="Center"
                                                                 VerticalOptions="Center"/>
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.RejectInvitationCommand}"
                                                                              CommandParameter="{Binding .}"/>
                                                    </Border.GestureRecognizers>
                                                </Border>
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- Accepted Section -->
                    <VerticalStackLayout Spacing="10"
                                         IsVisible="{Binding HasAccepted}">
                        <Label Text="ACEITOS"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource secondary_text_color}"
                               Margin="4,0,0,0"/>
                        <VerticalStackLayout Spacing="10"
                                             BindableLayout.ItemsSource="{Binding AcceptedInvitations}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:UserInvitationItem">
                                    <Border Stroke="{StaticResource Gray100}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 14"
                                            BackgroundColor="{StaticResource White}"
                                            Padding="14">
                                        <Grid ColumnDefinitions="44, *, Auto"
                                              ColumnSpacing="12">
                                            <Border WidthRequest="44"
                                                    HeightRequest="44"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 22"
                                                    BackgroundColor="#DCFCE7"
                                                    VerticalOptions="Center">
                                                <Label Text="{Binding EventInitial}"
                                                       FontSize="18"
                                                       FontAttributes="Bold"
                                                       TextColor="#16A34A"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"/>
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1"
                                                                 VerticalOptions="Center"
                                                                 Spacing="2">
                                                <Label Text="{Binding EventName}"
                                                       FontSize="15"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource primary_text_color}"
                                                       LineBreakMode="TailTruncation"/>
                                                <Label FontSize="11"
                                                       TextColor="{StaticResource secondary_text_color}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="Convidado por "/>
                                                            <Span Text="{Binding OrganizerName}"
                                                                  FontAttributes="Bold"/>
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <Border HorizontalOptions="Start"
                                                        BackgroundColor="{Binding RoleColor}"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 8"
                                                        Padding="8,3"
                                                        Margin="0,2,0,0">
                                                    <Label Text="{Binding Role}"
                                                           FontSize="10"
                                                           FontAttributes="Bold"
                                                           TextColor="{Binding RoleTextColor}"/>
                                                </Border>
                                            </VerticalStackLayout>
                                            <Border Grid.Column="2"
                                                    VerticalOptions="Center"
                                                    Padding="10,5"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 10"
                                                    BackgroundColor="#DCFCE7">
                                                <Label Text="Aceito"
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       TextColor="#16A34A"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- Rejected Section -->
                    <VerticalStackLayout Spacing="10"
                                         IsVisible="{Binding HasRejected}">
                        <Label Text="RECUSADOS"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource secondary_text_color}"
                               Margin="4,0,0,0"/>
                        <VerticalStackLayout Spacing="10"
                                             BindableLayout.ItemsSource="{Binding RejectedInvitations}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:UserInvitationItem">
                                    <Border Stroke="{StaticResource Gray100}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 14"
                                            BackgroundColor="{StaticResource White}"
                                            Padding="14"
                                            Opacity="0.65">
                                        <Grid ColumnDefinitions="44, *, Auto"
                                              ColumnSpacing="12">
                                            <Border WidthRequest="44"
                                                    HeightRequest="44"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 22"
                                                    BackgroundColor="{StaticResource Gray100}"
                                                    VerticalOptions="Center">
                                                <Label Text="{Binding EventInitial}"
                                                       FontSize="18"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource secondary_text_color}"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"/>
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1"
                                                                 VerticalOptions="Center"
                                                                 Spacing="2">
                                                <Label Text="{Binding EventName}"
                                                       FontSize="15"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource secondary_text_color}"
                                                       LineBreakMode="TailTruncation"/>
                                                <Label FontSize="11"
                                                       TextColor="{StaticResource secondary_text_color}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="Convidado por "/>
                                                            <Span Text="{Binding OrganizerName}"
                                                                  FontAttributes="Bold"/>
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <Border HorizontalOptions="Start"
                                                        BackgroundColor="{Binding RoleColor}"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 8"
                                                        Padding="8,3"
                                                        Margin="0,2,0,0">
                                                    <Label Text="{Binding Role}"
                                                           FontSize="10"
                                                           FontAttributes="Bold"
                                                           TextColor="{Binding RoleTextColor}"/>
                                                </Border>
                                            </VerticalStackLayout>
                                            <Border Grid.Column="2"
                                                    VerticalOptions="Center"
                                                    Padding="10,5"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 10"
                                                    BackgroundColor="#FEE2E2">
                                                <Label Text="Recusado"
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       TextColor="#DC2626"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
