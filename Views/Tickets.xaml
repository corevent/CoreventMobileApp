<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CoreventApp.ViewModels"
             x:Class="CoreventApp.Views.Tickets"
             x:Name="ThisPage"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:dtos="clr-namespace:CoreventApp.Models.Dtos"
             xmlns:controls="clr-namespace:CoreventApp.Views.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             Title="Ingressos"
             BackgroundColor="{StaticResource background_color}">
  <ContentPage.Behaviors>
    <toolkit:EventToCommandBehavior EventName="Appearing"
                                      BindingContext="{Binding Source={x:Reference ThisPage}, Path=BindingContext}"
                                      Command="{Binding LoadTicketsCommand}" />
  </ContentPage.Behaviors>
  <Grid RowDefinitions="auto,auto,*" Padding="20" RowSpacing="20">

    <Label Text="Meus Ingressos"
           Grid.Row="0"
           FontSize="22"
           FontAttributes="Bold"
           TextColor="{StaticResource primary_text_color}"/>

    <Border Grid.Row="1" Padding="4" StrokeThickness="0" StrokeShape="RoundRectangle 30" BackgroundColor="{StaticResource Gray100}">
      <Grid ColumnDefinitions="*,*" ColumnSpacing="0">
        <Border StrokeThickness="0" StrokeShape="RoundRectangle 26">
            <Border.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding IsProximosVisible}" Value="True">
                    <Setter Property="BackgroundColor" Value="{StaticResource toggle_active_bg}"/>
                </DataTrigger>
                <DataTrigger TargetType="Border" Binding="{Binding IsProximosVisible}" Value="False">
                    <Setter Property="BackgroundColor" Value="Transparent"/>
                </DataTrigger>
            </Border.Triggers>
            <Label Text="Próximos" HorizontalOptions="Center" Padding="0,10" FontAttributes="Bold" FontSize="14">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding IsProximosVisible}" Value="True">
                        <Setter Property="TextColor" Value="{StaticResource White}"/>
                    </DataTrigger>
                    <DataTrigger TargetType="Label" Binding="{Binding IsProximosVisible}" Value="False">
                        <Setter Property="TextColor" Value="{StaticResource secondary_text_color}"/>
                    </DataTrigger>
                </Label.Triggers>
            </Label>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding SelectProximosCommand}"/>
            </Border.GestureRecognizers>
        </Border>

        <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 26">
            <Border.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding IsPassadosVisible}" Value="True">
                    <Setter Property="BackgroundColor" Value="{StaticResource toggle_active_bg}"/>
                </DataTrigger>
                <DataTrigger TargetType="Border" Binding="{Binding IsPassadosVisible}" Value="False">
                    <Setter Property="BackgroundColor" Value="Transparent"/>
                </DataTrigger>
            </Border.Triggers>
            <Label Text="Passados" HorizontalOptions="Center" Padding="0,10" FontAttributes="Bold" FontSize="14">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding IsPassadosVisible}" Value="True">
                        <Setter Property="TextColor" Value="{StaticResource White}"/>
                    </DataTrigger>
                    <DataTrigger TargetType="Label" Binding="{Binding IsPassadosVisible}" Value="False">
                        <Setter Property="TextColor" Value="{StaticResource secondary_text_color}"/>
                    </DataTrigger>
                </Label.Triggers>
            </Label>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding SelectPassadosCommand}"/>
            </Border.GestureRecognizers>
        </Border>
      </Grid>
    </Border>

    <ScrollView Grid.Row="2">
      <VerticalStackLayout Spacing="10">

        <!-- Loading -->
        <ActivityIndicator IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           HorizontalOptions="Center"
                           Margin="0,40,0,0"
                           Color="{StaticResource primary_orange_color}"/>

        <!-- Próximos -->
        <VerticalStackLayout Spacing="10"
                             IsVisible="{Binding IsProximosVisible}"
                             BindableLayout.ItemsSource="{Binding ProximosTickets}">
          <BindableLayout.EmptyView>
            <Label Text="Nenhum ingresso próximo"
                   FontSize="14"
                   TextColor="{StaticResource secondary_text_color}"
                   HorizontalOptions="Center"
                   Margin="0,40,0,0"/>
          </BindableLayout.EmptyView>
          <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="dtos:UserTicketDataDto">
              <Border Stroke="{StaticResource Gray100}"
                      StrokeThickness="1"
                      StrokeShape="RoundRectangle 16"
                      BackgroundColor="{StaticResource White}"
                      Padding="14">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">

                  <Label Text="{Binding Event.Title}"
                         FontSize="15"
                         FontAttributes="Bold"
                         TextColor="{StaticResource primary_text_color}"
                         LineBreakMode="TailTruncation"/>

                  <controls:StatusBadge Grid.Column="1" Status="{Binding Status}" Kind="Ticket" />

                  <HorizontalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="6">
                    <mi:MauiIcon Icon="{mi:Cupertino TagCircleFill}"
                                 Style="{StaticResource SmallIcon}"
                                 IconSize="14"
                                 IconColor="{StaticResource secondary_text_color}"/>
                    <Label Text="{Binding TicketType.Name}"
                           FontSize="13"
                           TextColor="{StaticResource secondary_text_color}"/>
                    <Label Text="•"
                           FontSize="13"
                           TextColor="{StaticResource secondary_text_color}"/>
                    <Label FontSize="13" TextColor="{StaticResource primary_orange_color}" FontAttributes="Bold">
                      <Label.FormattedText>
                        <FormattedString>
                          <Span Text="R$ "/>
                          <Span Text="{Binding TicketType.Price, StringFormat='{0:F2}'}"/>
                        </FormattedString>
                      </Label.FormattedText>
                    </Label>
                  </HorizontalStackLayout>

                  <Label Grid.Row="2" Grid.ColumnSpan="2"
                         FontSize="11"
                         TextColor="{StaticResource Gray400}"
                         LineBreakMode="MiddleTruncation"
                         Text="{Binding QrToken, StringFormat='QR: {0}'}"/>

                </Grid>
                <Border.GestureRecognizers>
                  <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TicketsViewModel}}, Path=OpenTicketQrCodeCommand}"
                                        CommandParameter="{Binding .}"/>
                </Border.GestureRecognizers>
              </Border>
            </DataTemplate>
          </BindableLayout.ItemTemplate>
        </VerticalStackLayout>

        <!-- Passados -->
        <VerticalStackLayout Spacing="10"
                             IsVisible="{Binding IsPassadosVisible}"
                             BindableLayout.ItemsSource="{Binding PassadosTickets}">
          <BindableLayout.EmptyView>
            <Label Text="Nenhum ingresso passado"
                   FontSize="14"
                   TextColor="{StaticResource secondary_text_color}"
                   HorizontalOptions="Center"
                   Margin="0,40,0,0"/>
          </BindableLayout.EmptyView>
          <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="dtos:UserTicketDataDto">
              <Border Stroke="{StaticResource Gray100}"
                      StrokeThickness="1"
                      StrokeShape="RoundRectangle 16"
                      BackgroundColor="{StaticResource White}"
                      Padding="14">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">

                  <Label Text="{Binding Event.Title}"
                         FontSize="15"
                         FontAttributes="Bold"
                         TextColor="{StaticResource primary_text_color}"
                         LineBreakMode="TailTruncation"/>

                  <controls:StatusBadge Grid.Column="1" Status="{Binding Status}" Kind="Ticket" />

                  <HorizontalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="6">
                    <mi:MauiIcon Icon="{mi:Cupertino TagCircleFill}"
                                 Style="{StaticResource SmallIcon}"
                                 IconSize="14"
                                 IconColor="{StaticResource secondary_text_color}"/>
                    <Label Text="{Binding TicketType.Name}"
                           FontSize="13"
                           TextColor="{StaticResource secondary_text_color}"/>
                    <Label Text="•"
                           FontSize="13"
                           TextColor="{StaticResource secondary_text_color}"/>
                    <Label FontSize="13" TextColor="{StaticResource primary_orange_color}" FontAttributes="Bold">
                      <Label.FormattedText>
                        <FormattedString>
                          <Span Text="R$ "/>
                          <Span Text="{Binding TicketType.Price, StringFormat='{0:F2}'}"/>
                        </FormattedString>
                      </Label.FormattedText>
                    </Label>
                  </HorizontalStackLayout>

                  <Label Grid.Row="2" Grid.ColumnSpan="2"
                         FontSize="11"
                         TextColor="{StaticResource Gray400}"
                         LineBreakMode="MiddleTruncation"
                         Text="{Binding QrToken, StringFormat='QR: {0}'}"/>

                </Grid>
                <Border.GestureRecognizers>
                  <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TicketsViewModel}}, Path=OpenTicketQrCodeCommand}"
                                        CommandParameter="{Binding .}"/>
                </Border.GestureRecognizers>
              </Border>
            </DataTemplate>
          </BindableLayout.ItemTemplate>
        </VerticalStackLayout>

      </VerticalStackLayout>
    </ScrollView>

  </Grid>
</ContentPage>
