<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CoreventApp.ViewModels"
             xmlns:dtos="clr-namespace:CoreventApp.Models.Dtos"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="CoreventApp.Views.Favorites"
             x:DataType="vm:FavoritesViewModel"
             x:Name="ThisPage"
             Title="Favorites"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource background_color}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing"
                                          BindingContext="{Binding Source={x:Reference ThisPage}, Path=BindingContext}"
                                          Command="{Binding LoadFavoritesCommand}" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto, *" Padding="20" RowSpacing="20">

        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto, *, Auto"
              VerticalOptions="Center">
            <Border Style="{StaticResource BackButtonContainer}">
                <mi:MauiIcon Icon="{mi:Cupertino ArrowLeft}" Style="{StaticResource BackIcon}"/>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                </Border.GestureRecognizers>
            </Border>

            <Label Grid.Column="1"
                   Text="Seus Favoritos"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{StaticResource primary_text_color}"
                   VerticalOptions="Center"
                   Margin="12,0,0,0"/>
        </Grid>

        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="{StaticResource primary_orange_color}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"/>

        <!-- Favorites List with Pull-to-Refresh -->
        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}"
                     IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
            <CollectionView ItemsSource="{Binding FavoriteEvents}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical"
                            ItemSpacing="14"/>
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Padding="40">
                        <Label Text="Nenhum favorito ainda"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource secondary_text_color}"
                               HorizontalOptions="Center"/>
                        <Label Text="Eventos favoritados aparecerão aqui"
                               FontSize="13"
                               TextColor="{StaticResource secondary_text_color}"
                               HorizontalOptions="Center"
                               Margin="0,8,0,0"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:EventListItemDto">
                        <Border Stroke="{StaticResource Gray100}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 20"
                                BackgroundColor="{StaticResource White}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectEventCommand}"
                                    CommandParameter="{Binding}"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="100, *" Padding="8, 6">
                                <!-- Image -->
                                <Border WidthRequest="100"
                                        HeightRequest="100"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 20">
                                    <Grid>
                                        <Image Source="{Binding BannerUrl, TargetNullValue='https://placehold.co/200x200/FF5722/FFFFFF.png?text=Evento'}"
                                               Aspect="AspectFill"/>
                                        <Border IsVisible="{Binding IsAdultOnly}"
                                                Padding="6,2"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 8"
                                                BackgroundColor="#FEE2E2"
                                                HorizontalOptions="Start"
                                                VerticalOptions="End"
                                                Margin="6">
                                            <Label Text="+18"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="#DC2626"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Content -->
                                <VerticalStackLayout Grid.Column="1"
                                                     Padding="12,6,12,6"
                                                     Spacing="2"
                                                     VerticalOptions="Center">
                                    <Label Text="{Binding Category, Converter={StaticResource CategoryDisplayConverter}}"
                                           FontSize="10"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource secondary_text_color}"/>

                                    <Label Text="{Binding Title}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource primary_text_color}"
                                           LineBreakMode="TailTruncation"/>

                                    <HorizontalStackLayout Spacing="4">
                                        <mi:MauiIcon Icon="{mi:Cupertino MapPin}"
                                                     IconSize="11"
                                                     IconColor="{StaticResource icon_default_color}"
                                                     VerticalOptions="Center"/>
                                        <Label Text="{Binding LocationName}"
                                               FontSize="11"
                                               TextColor="{StaticResource secondary_text_color}"
                                               LineBreakMode="TailTruncation"
                                               VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label"
                                                             Binding="{Binding LocationType}"
                                                             Value="online">
                                                    <Setter Property="Text" Value="Evento Online"/>
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Spacing="4">
                                        <mi:MauiIcon Icon="{mi:Cupertino Calendar}"
                                                     IconSize="11"
                                                     IconColor="{StaticResource icon_default_color}"
                                                     VerticalOptions="Center"/>
                                        <Label Text="{Binding StartDate, StringFormat='{0:dd MMM, yyyy}'}"
                                               FontSize="11"
                                               TextColor="{StaticResource secondary_text_color}"
                                               VerticalOptions="Center"/>
                                        <Label Text=" - "
                                               FontSize="11"
                                               TextColor="{StaticResource secondary_text_color}"
                                               VerticalOptions="Center"/>
                                        <Label Text="{Binding EndDate, StringFormat='{0:dd MMM, yyyy}'}"
                                               FontSize="11"
                                               TextColor="{StaticResource secondary_text_color}"
                                               VerticalOptions="Center"/>
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Spacing="4">
                                        <mi:MauiIcon Icon="{mi:Cupertino Person}"
                                                     IconSize="11"
                                                     IconColor="{StaticResource icon_default_color}"
                                                     VerticalOptions="Center"/>
                                        <Label Text="{Binding Organizer.Name}"
                                               FontSize="11"
                                               TextColor="{StaticResource secondary_text_color}"
                                               LineBreakMode="TailTruncation"
                                               VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
