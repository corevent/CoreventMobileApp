<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CoreventApp.ViewModels"
             xmlns:dtos="clr-namespace:CoreventApp.Models.Dtos"
              xmlns:cv="clr-namespace:CoreventApp.Converters"
              xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
              x:Class="CoreventApp.Views.PanelOrganizer"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             x:DataType="vm:PanelOrganizerViewModel"
             x:Name="ThisPage"
             Title="Painel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource background_color}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing"
                                        BindingContext="{Binding Source={x:Reference ThisPage}, Path=BindingContext}"
                                        Command="{Binding LoadCommand}" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <ResourceDictionary>
            <cv:StatusDisplayConverter x:Key="StatusDisplayConverter"/>
            <toolkit:InvertedBoolConverter x:Key="InvertedBool"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *">
        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto, *, Auto"
              Padding="16,14,16,10"
              VerticalOptions="Center">
            <Border Style="{StaticResource BackButtonContainer}">
                <mi:MauiIcon Icon="{mi:Cupertino ArrowLeft}"
                             Style="{StaticResource BackIcon}"/>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                </Border.GestureRecognizers>
            </Border>

            <Label Grid.Column="1"
                   Text="Painel"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{StaticResource primary_text_color}"
                   VerticalOptions="Center"
                   Margin="12,0,0,0"/>
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,14,16,20"
                                 Spacing="18">

                <!-- Transfer Banner -->
                <Border Stroke="{StaticResource Gray100}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        BackgroundColor="{StaticResource White}"
                        Padding="16,12">
                    <Grid ColumnDefinitions="48, *, Auto"
                          ColumnSpacing="12"
                          VerticalOptions="Center">
                        <Border BackgroundColor="#FEF3C7"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                WidthRequest="44"
                                HeightRequest="44"
                                HorizontalOptions="Start">
                            <mi:MauiIcon Icon="{mi:Cupertino Creditcard}"
                                         IconSize="22"
                                         IconColor="{StaticResource icon_default_color}"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"/>
                        </Border>

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="2">
                            <Label Text="Dados de Repasse"
                                   FontAttributes="Bold"
                                   FontSize="15"
                                   TextColor="{StaticResource primary_text_color}"/>
                            <Label Text="Configure como você recebe suas vendas"
                                   FontSize="11"
                                   TextColor="{StaticResource secondary_text_color}"/>
                            <Label Text="Obrigatório para criar eventos"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="#DC2626"
                                   IsVisible="{Binding HasPaymentInfo, Converter={StaticResource InvertedBool}}"/>
                        </VerticalStackLayout>

                        <Button Grid.Column="2"
                                Text="Configurar"
                                TextColor="{StaticResource White}"
                                FontSize="12"
                                FontAttributes="Bold"
                                HeightRequest="34"
                                Padding="16,0"
                                Background="{StaticResource gradient_button}"
                                CornerRadius="16"
                                Command="{Binding ConfigureTransferCommand}"/>
                    </Grid>
                </Border>

                <!-- Filter Chips -->
                <ScrollView Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="8"
                                           BindableLayout.ItemsSource="{Binding FilterChips}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:StatusFilterChip">
                                <Border Padding="14,7"
                                        StrokeShape="RoundRectangle 18"
                                        StrokeThickness="1"
                                        Stroke="{StaticResource Gray100}"
                                        BackgroundColor="{StaticResource White}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border"
                                                     Binding="{Binding IsSelected}"
                                                     Value="True">
                                            <Setter Property="BackgroundColor"
                                                    Value="{StaticResource primary_orange_color}"/>
                                            <Setter Property="Stroke"
                                                    Value="{StaticResource primary_orange_color}"/>
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{Binding Label}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource secondary_text_color}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label"
                                                         Binding="{Binding IsSelected}"
                                                         Value="True">
                                                <Setter Property="TextColor"
                                                        Value="{StaticResource White}"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.FilterByStatusCommand}"
                                            CommandParameter="{Binding}"/>
                                    </Border.GestureRecognizers>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- My Events Header + New Event Button -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Meus Eventos"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource primary_text_color}"/>

                    <Button Text="Novo Evento"
                            TextColor="{StaticResource White}"
                            FontAttributes="Bold"
                            FontSize="15"
                            HeightRequest="46"
                            Background="{StaticResource gradient_button}"
                            CornerRadius="12"
                            Command="{Binding NewEventCommand}"
                            IsEnabled="{Binding HasPaymentInfo}"/>

                    <Label Text="Você precisa configurar seus dados de repasse antes de criar um evento."
                           FontSize="12"
                           TextColor="{StaticResource secondary_text_color}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           IsVisible="{Binding HasPaymentInfo, Converter={StaticResource InvertedBool}}"/>
                </VerticalStackLayout>

                <!-- Events List -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding FilteredEvents}"
                                     Spacing="12">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="dtos:EventListItemDto">
                            <Border Stroke="{StaticResource Gray100}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 20"
                                    BackgroundColor="{StaticResource White}"
                                    Padding="12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectEventCommand}"
                                        CommandParameter="{Binding}"/>
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="80, *, Auto"
                                      ColumnSpacing="12">
                                    <Border WidthRequest="80"
                                            HeightRequest="80"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 14">
                                        <Image Source="{Binding BannerUrl, TargetNullValue='https://placehold.co/200x200/FF5722/FFFFFF.png?text=Evento'}"
                                               Aspect="AspectFill"/>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="4"
                                                         VerticalOptions="Center">
                                        <Label Text="{Binding Title}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource primary_text_color}"/>
                                        <Label Text="{Binding StartDate, StringFormat='{0:dd MMM, yyyy}'}"
                                               FontSize="12"
                                               TextColor="{StaticResource secondary_text_color}"/>

                                        <HorizontalStackLayout Spacing="8"
                                                                Margin="0,4,0,0">
                                            <Border Padding="8,2"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 8"
                                                    BackgroundColor="#E8F5E9">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border"
                                                                 Binding="{Binding Status}"
                                                                 Value="going">
                                                        <Setter Property="BackgroundColor"
                                                                Value="#DBEAFE"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border"
                                                                 Binding="{Binding Status}"
                                                                 Value="finished">
                                                        <Setter Property="BackgroundColor"
                                                                Value="#F3F4F6"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border"
                                                                 Binding="{Binding Status}"
                                                                 Value="draft">
                                                        <Setter Property="BackgroundColor"
                                                                Value="#FEF9C3"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border"
                                                                 Binding="{Binding Status}"
                                                                 Value="canceled">
                                                        <Setter Property="BackgroundColor"
                                                                Value="#FEE2E2"/>
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Label FontSize="10"
                                                       FontAttributes="Bold"
                                                       TextColor="#4CAF50">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label"
                                                                     Binding="{Binding Status}"
                                                                     Value="going">
                                                            <Setter Property="TextColor"
                                                                    Value="#2563EB"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label"
                                                                     Binding="{Binding Status}"
                                                                     Value="finished">
                                                            <Setter Property="TextColor"
                                                                    Value="#6B7280"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label"
                                                                     Binding="{Binding Status}"
                                                                     Value="draft">
                                                            <Setter Property="TextColor"
                                                                    Value="#A16207"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label"
                                                                     Binding="{Binding Status}"
                                                                     Value="canceled">
                                                            <Setter Property="TextColor"
                                                                    Value="#DC2626"/>
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                    <Label.Text>
                                                        <Binding Path="Status">
                                                            <Binding.Converter>
                                                                <cv:StatusDisplayConverter/>
                                                            </Binding.Converter>
                                                        </Binding>
                                                    </Label.Text>
                                                </Label>
                                            </Border>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <mi:MauiIcon Grid.Column="2"
                                                 Icon="{mi:Cupertino ChevronRight}"
                                                 Style="{StaticResource ChevronIcon}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Empty State -->
                <Label Text="Nenhum evento encontrado."
                       FontSize="14"
                       TextColor="{StaticResource secondary_text_color}"
                       HorizontalOptions="Center"
                       Margin="0,20,0,0"
                       IsVisible="False">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label"
                                     Binding="{Binding FilteredEvents.Count}"
                                     Value="0">
                            <Setter Property="IsVisible" Value="True"/>
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
                <Label Text="Crie seu primeiro evento!"
                       FontSize="14"
                       TextColor="{StaticResource secondary_text_color}"
                       HorizontalOptions="Center"
                       IsVisible="False">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label"
                                     Binding="{Binding AllEvents.Count}"
                                     Value="0">
                            <Setter Property="IsVisible" Value="True"/>
                        </DataTrigger>
                    </Label.Triggers>
                </Label>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
