<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CoreventApp.Views.EditProfile"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             Title="EditProfile"
             BackgroundColor="{StaticResource background_color}">
    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding LoadUserCommand}" />
    </ContentPage.Behaviors>
    <Grid>
        <ScrollView>
            <Grid RowDefinitions="auto, *" Padding="20" RowSpacing="24">

                <!-- Header -->
                <Grid Grid.Row="0"
                  ColumnDefinitions="Auto, *, Auto"
                  VerticalOptions="Center">
                    <Border Style="{StaticResource BackButtonContainer}">
                        <mi:MauiIcon Icon="{mi:Cupertino ArrowLeft}" Style="{StaticResource BackIcon}"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                        </Border.GestureRecognizers>
                    </Border>

                    <Label Grid.Column="1"
                        Text="Editar Perfil"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{StaticResource primary_text_color}"
                        VerticalOptions="Center"
                        Margin="12,0,0,0"/>
                </Grid>

                <!-- Form -->
                <Grid Grid.Row="1" RowDefinitions="auto, auto, auto, auto, auto" RowSpacing="24">

                    <!-- Avatar -->
                    <VerticalStackLayout Grid.Row="0" Spacing="8" HorizontalOptions="Center">
                        <Border WidthRequest="96"
                                HeightRequest="96"
                                StrokeThickness="3"
                                Stroke="{StaticResource primary_orange_color}"
                                StrokeShape="RoundRectangle 48"
                                BackgroundColor="{StaticResource card_icon_bg}"
                                HorizontalOptions="Center">
                            <Image Source="{Binding UserAvatar}"
                                   Aspect="AspectFill"
                                   WidthRequest="96"
                                   HeightRequest="96"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PickAvatarCommand}"/>
                            </Border.GestureRecognizers>
                        </Border>
                        <Label Text="Tocar para alterar foto"
                               FontSize="12"
                               TextColor="{StaticResource primary_orange_color}"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>

                    <!-- NOME COMPLETO -->
                    <Grid Grid.Row="1" RowDefinitions="auto, auto" RowSpacing="6">
                        <Label Grid.Row="0"
                               Text="NOME COMPLETO"
                               FontSize="13"
                               TextColor="{StaticResource Gray500}"/>
                        <Border Grid.Row="1"
                                Stroke="{StaticResource Gray100}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="{StaticResource White}"
                                Padding="12,0">
                            <Entry Text="{Binding UserName}"
                                   Placeholder="Seu nome completo"
                                   BackgroundColor="Transparent"
                                   TextColor="{StaticResource input_text}"/>
                        </Border>
                    </Grid>

                    <!-- TELEFONE -->
                    <Grid Grid.Row="2" RowDefinitions="auto, auto" RowSpacing="6">
                        <Label Grid.Row="0"
                               Text="TELEFONE"
                               FontSize="13"
                               TextColor="{StaticResource Gray500}"/>
                        <Border Grid.Row="1"
                                Stroke="{StaticResource Gray100}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="{StaticResource White}"
                                Padding="12,0">
                            <Entry Text="{Binding UserPhone}"
                                   Placeholder="(11) 91234-5678"
                                   Keyboard="Telephone"
                                   BackgroundColor="Transparent"
                                   TextColor="{StaticResource input_text}"/>
                        </Border>
                    </Grid>

                    <!-- Botão Salvar -->
                    <Button Grid.Row="3"
                            Text="Salvar Alterações"
                            Command="{Binding SaveCommand}"
                            Background="{StaticResource gradient_button}"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="48"
                            FontAttributes="Bold"
                            Margin="0,8,0,0"/>
                </Grid>
            </Grid>
        </ScrollView>

        <!-- Loading Overlay -->
        <Grid IsVisible="{Binding IsBusy}"
              BackgroundColor="#80000000"
              InputTransparent="False">
            <VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="12">
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   Color="{StaticResource White}"
                                   HeightRequest="48"
                                   WidthRequest="48"/>
                <Label Text="Fazendo upload..."
                       TextColor="{StaticResource White}"
                       FontSize="16"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
