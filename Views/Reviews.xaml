<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CoreventApp.ViewModels"
             xmlns:dtos="clr-namespace:CoreventApp.Models.Dtos"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:converters="clr-namespace:CoreventApp.Converters"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="CoreventApp.Views.Reviews"
             x:Name="ThisPage"
             x:DataType="vm:ReviewsViewModel"
             Title="Reviews"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource background_color}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing"
                                          BindingContext="{Binding Source={x:Reference ThisPage}, Path=BindingContext}"
                                          Command="{Binding LoadItemsCommand}" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:RatingToStarsConverter x:Key="RatingToStars"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *" Padding="20" RowSpacing="20">

        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto, *, Auto"
              VerticalOptions="Center">
            <Border Style="{StaticResource BackButtonContainer}">
                <mi:MauiIcon Icon="{mi:Cupertino ArrowLeft}" Style="{StaticResource BackIcon}"/>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                </Border.GestureRecognizers>
            </Border>

            <Label Grid.Column="1"
                   Text="Suas avaliações"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{StaticResource primary_text_color}"
                   VerticalOptions="Center"
                   Margin="12,0,0,0"/>
        </Grid>

        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="{StaticResource primary_orange_color}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"/>

        <!-- Ratings List with Pull-to-Refresh -->
        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}"
                     IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
            <CollectionView ItemsSource="{Binding Items}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="14"/>
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Padding="40">
                        <Label Text="Nenhuma avaliação ainda"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource secondary_text_color}"
                               HorizontalOptions="Center"/>
                        <Label Text="Eventos que você avaliou aparecerão aqui"
                               FontSize="13"
                               TextColor="{StaticResource secondary_text_color}"
                               HorizontalOptions="Center"
                               Margin="0,8,0,0"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:MyRatingItemDto">
                        <Border Stroke="{StaticResource Gray100}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 20"
                                BackgroundColor="{StaticResource White}">
                            <Grid ColumnDefinitions="64, *"
                                  Padding="12"
                                  ColumnSpacing="14">

                                <!-- Thumbnail -->
                                <Border StrokeThickness="0"
                                        StrokeShape="RoundRectangle 14"
                                        HeightRequest="64"
                                        WidthRequest="64">
                                    <Image Source="{Binding BannerUrl}"
                                           Aspect="AspectFill"/>
                                </Border>

                                <!-- Info -->
                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="6"
                                                     VerticalOptions="Center">

                                    <Label Text="{Binding EventTitle}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource primary_text_color}"
                                           LineBreakMode="TailTruncation"/>

                                    <HorizontalStackLayout Spacing="4">
                                        <mi:MauiIcon Icon="{mi:Cupertino Star}"
                                                     IconSize="14"
                                                     IconColor="#FFB800"
                                                     VerticalOptions="Center"/>
                                        <Label Text="{Binding UserRating, StringFormat='{0:F1}'}"
                                               FontSize="13"
                                               TextColor="{StaticResource secondary_text_color}"
                                               VerticalOptions="Center"/>
                                    </HorizontalStackLayout>

                                    <!-- User Rating -->
                                    <Label Text="{Binding UserRating, Converter={StaticResource RatingToStars}}"
                                           FontSize="16"
                                           TextColor="#FFB800"
                                           VerticalOptions="Center"/>

                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
