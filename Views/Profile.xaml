<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CoreventApp.ViewModels"
             x:DataType="viewmodels:ProfileViewModel"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="CoreventApp.Views.Profile"
             Title="Perfil"
             BackgroundColor="{StaticResource background_color}">

  <ContentPage.Behaviors>
    <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding LoadUserCommand}" />
  </ContentPage.Behaviors>

  <ScrollView>
    <VerticalStackLayout Padding="16,14,16,20"
                         Spacing="20">

      <!-- Header: Title + Avatar -->
      <VerticalStackLayout
        VerticalOptions="Center">
        <Label Text="Perfil"
               FontSize="20"
               FontAttributes="Bold"
               TextColor="{StaticResource primary_text_color}"
               VerticalOptions="Center"/>
      </VerticalStackLayout>

      <!-- Profile Card -->
      <Border Stroke="{StaticResource Gray100}"
              StrokeThickness="1"
              StrokeShape="RoundRectangle 20"
              BackgroundColor="{StaticResource White}"
              Padding="20">
        <VerticalStackLayout Spacing="8"
                             HorizontalOptions="Center">
          <Border WidthRequest="80"
                  HeightRequest="80"
                  StrokeThickness="0"
                  StrokeShape="RoundRectangle 40"
                  BackgroundColor="{StaticResource card_icon_bg}"
                  HorizontalOptions="Center">
            <Image Source="{Binding UserAvatar}"
                   Aspect="AspectFill"
                   WidthRequest="80"
                   HeightRequest="80"/>
          </Border>
          <Label Text="{Binding UserName}"
                 FontSize="18"
                 FontAttributes="Bold"
                 HorizontalTextAlignment="Center"
                 TextColor="{StaticResource primary_text_color}"/>
          <Label Text="{Binding UserEmail}"
                 FontSize="13"
                 HorizontalTextAlignment="Center"
                 TextColor="{StaticResource secondary_text_color}"/>
        </VerticalStackLayout>
      </Border>

      <!-- Menu Items -->
      <VerticalStackLayout Spacing="12">

        <Border Padding="14"
                Stroke="{StaticResource Gray100}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                BackgroundColor="{StaticResource White}">
          <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding EditProfileCommand}"/>
          </Border.GestureRecognizers>
          <Grid ColumnDefinitions="Auto, *, Auto"
                ColumnSpacing="14">
            <Border Style="{StaticResource MenuIconContainer}">
              <mi:MauiIcon Icon="{mi:Cupertino Person}"
                           Style="{StaticResource MenuIcon}"/>
            </Border>
            <Label Text="Dados Pessoais"
                   Grid.Column="1"
                   VerticalOptions="Center"
                   FontSize="16"
                   TextColor="{StaticResource profile_menu_text}"/>
            <mi:MauiIcon Grid.Column="2"
                         Icon="{mi:Cupertino ChevronRight}"
                         Style="{StaticResource ChevronIcon}"/>
          </Grid>
        </Border>

        <Border Padding="14"
                Stroke="{StaticResource Gray100}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                BackgroundColor="{StaticResource White}">
          <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding PurchaseHistoryCommand}"/>
          </Border.GestureRecognizers>
          <Grid ColumnDefinitions="Auto, *, Auto"
                ColumnSpacing="14">
            <Border Style="{StaticResource MenuIconContainer}">
              <mi:MauiIcon Icon="{mi:Cupertino TagCircleFill}"
                           Style="{StaticResource MenuIcon}"/>
            </Border>
            <Label Text="Histórico de Compra"
                   Grid.Column="1"
                   VerticalOptions="Center"
                   FontSize="16"
                   TextColor="{StaticResource profile_menu_text}"/>
            <mi:MauiIcon Grid.Column="2"
                         Icon="{mi:Cupertino ChevronRight}"
                         Style="{StaticResource ChevronIcon}"/>
          </Grid>
        </Border>

        <Border Padding="14"
                Stroke="{StaticResource Gray100}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                BackgroundColor="{StaticResource White}">
          <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding FavoritesCommand}"/>
          </Border.GestureRecognizers>
          <Grid ColumnDefinitions="Auto, *, Auto"
                ColumnSpacing="14">
            <Border Style="{StaticResource MenuIconContainer}">
              <mi:MauiIcon Icon="{mi:Cupertino Heart}"
                           Style="{StaticResource MenuIcon}"/>
            </Border>
            <Label Text="Meus Favoritos"
                   Grid.Column="1"
                   VerticalOptions="Center"
                   FontSize="16"
                   TextColor="{StaticResource profile_menu_text}"/>
            <mi:MauiIcon Grid.Column="2"
                         Icon="{mi:Cupertino ChevronRight}"
                         Style="{StaticResource ChevronIcon}"/>
          </Grid>
        </Border>

        <Border Padding="14"
                Stroke="{StaticResource Gray100}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                BackgroundColor="{StaticResource White}">
          <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding ReviewsCommand}"/>
          </Border.GestureRecognizers>
          <Grid ColumnDefinitions="Auto, *, Auto"
                ColumnSpacing="14">
            <Border Style="{StaticResource MenuIconContainer}">
              <mi:MauiIcon Icon="{mi:Cupertino Star}"
                           Style="{StaticResource MenuIcon}"/>
            </Border>
            <Label Text="Avaliações"
                   Grid.Column="1"
                   VerticalOptions="Center"
                   FontSize="16"
                   TextColor="{StaticResource profile_menu_text}"/>
            <mi:MauiIcon Grid.Column="2"
                         Icon="{mi:Cupertino ChevronRight}"
                         Style="{StaticResource ChevronIcon}"/>
          </Grid>
        </Border>

        <Border Padding="14"
                Stroke="{StaticResource Gray100}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                BackgroundColor="{StaticResource White}">
          <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding SettingsCommand}"/>
          </Border.GestureRecognizers>
          <Grid ColumnDefinitions="Auto, *, Auto"
                ColumnSpacing="14">
            <Border Style="{StaticResource MenuIconContainer}">
              <mi:MauiIcon Icon="{mi:Cupertino Gear}"
                           Style="{StaticResource MenuIcon}"/>
            </Border>
            <Label Text="Configurações"
                   Grid.Column="1"
                   VerticalOptions="Center"
                   FontSize="16"
                   TextColor="{StaticResource profile_menu_text}"/>
            <mi:MauiIcon Grid.Column="2"
                         Icon="{mi:Cupertino ChevronRight}"
                         Style="{StaticResource ChevronIcon}"/>
          </Grid>
        </Border>
      </VerticalStackLayout>

      <!-- Organizador Section -->
      <VerticalStackLayout Spacing="12"
                           IsVisible="{Binding IsAdult}">
        <Label Text="ORGANIZADOR"
               FontSize="12"
               FontAttributes="Bold"
               TextColor="{StaticResource secondary_text_color}"
               Margin="4,0,0,0"/>
        <Border Padding="14"
                Stroke="{StaticResource Gray100}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                BackgroundColor="{StaticResource White}">
          <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding PanelOrganizerCommand}"/>
          </Border.GestureRecognizers>
          <Grid ColumnDefinitions="Auto, *, Auto"
                ColumnSpacing="14">
            <Border Style="{StaticResource MenuIconContainer}">
              <mi:MauiIcon Icon="{mi:Cupertino RectangleGrid2x2}"
                           Style="{StaticResource MenuIcon}"/>
            </Border>
            <Label Text="Painel do Organizador"
                   Grid.Column="1"
                   VerticalOptions="Center"
                   FontSize="16"
                   TextColor="{StaticResource profile_menu_text}"/>
            <mi:MauiIcon Grid.Column="2"
                         Icon="{mi:Cupertino ChevronRight}"
                         Style="{StaticResource ChevronIcon}"/>
          </Grid>
        </Border>
      </VerticalStackLayout>

      <!-- Colaborador Section -->
      <VerticalStackLayout Spacing="12"
                           IsVisible="{Binding IsAdult}">
        <Label Text="COLABORADOR"
               FontSize="12"
               FontAttributes="Bold"
               TextColor="{StaticResource secondary_text_color}"
               Margin="4,0,0,0"/>
        <Border Padding="14"
                Stroke="{StaticResource Gray100}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                BackgroundColor="{StaticResource White}">
          <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding PanelCollaboratorCommand}"/>
          </Border.GestureRecognizers>
          <Grid ColumnDefinitions="Auto, *, Auto"
                ColumnSpacing="14">
            <Border Style="{StaticResource MenuIconContainer}">
              <mi:MauiIcon Icon="{mi:Cupertino Shield}"
                           Style="{StaticResource MenuIcon}"/>
            </Border>
            <Label Text="Painel do Colaborador"
                   Grid.Column="1"
                   VerticalOptions="Center"
                   FontSize="16"
                   TextColor="{StaticResource profile_menu_text}"/>
            <mi:MauiIcon Grid.Column="2"
                         Icon="{mi:Cupertino ChevronRight}"
                         Style="{StaticResource ChevronIcon}"/>
          </Grid>
        </Border>
      </VerticalStackLayout>

      <!-- Logout -->
      <Border Padding="14"
              Stroke="{StaticResource Gray100}"
              StrokeThickness="1"
              StrokeShape="RoundRectangle 20"
              BackgroundColor="{StaticResource White}">
        <Border.GestureRecognizers>
          <TapGestureRecognizer Command="{Binding LogoutCommand}"/>
        </Border.GestureRecognizers>
        <HorizontalStackLayout Spacing="10"
                               HorizontalOptions="Center">
          <mi:MauiIcon Icon="{mi:Cupertino SquareArrowDown}"
                       Rotation="-90"
                       IconSize="18"
                       IconColor="{StaticResource primary_orange_color}"
                       VerticalOptions="Center"/>
          <Label Text="Sair da Conta"
                 VerticalOptions="Center"
                 FontSize="16"
                 FontAttributes="Bold"
                 TextColor="{StaticResource primary_orange_color}"/>
        </HorizontalStackLayout>
      </Border>

    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
