<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CoreventApp.ViewModels"
             xmlns:cv="clr-namespace:CoreventApp.Converters"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="CoreventApp.Views.EventTeam"
             x:DataType="vm:EventTeamViewModel"
             x:Name="ThisPage"
             Title="Equipe"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource background_color}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="InvalidEntryStyle" TargetType="Entry">
                <Setter Property="TextColor" Value="{StaticResource error_color}" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16,14,16,20"
                             Spacing="18">

            <!-- Header -->
            <Grid ColumnDefinitions="Auto, *"
                  VerticalOptions="Center">
                <Border Style="{StaticResource BackButtonContainer}">
                    <mi:MauiIcon Icon="{mi:Cupertino ArrowLeft}"
                            Style="{StaticResource BackIcon}"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                    </Border.GestureRecognizers>
                </Border>
                <VerticalStackLayout Grid.Column="1"
                                     Margin="12,0,0,0"
                                     VerticalOptions="Center"
                                     Spacing="2">
                    <Label Text="Equipe"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{StaticResource primary_text_color}"/>
                    <Label Text="{Binding EventName}"
                           FontSize="12"
                           TextColor="{StaticResource secondary_text_color}"/>
                </VerticalStackLayout>
            </Grid>

            <!-- Invite Card -->
            <Border Stroke="{StaticResource Gray100}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    BackgroundColor="{StaticResource White}"
                    Padding="16"
                    IsVisible="{Binding CanInvite}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="{Binding AccessLevelFormTitle}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource primary_text_color}"/>

                    <Entry Text="{Binding InviteEmail}"
                           Placeholder="E-mail do colaborador"
                           Keyboard="Email"
                           TextColor="{StaticResource input_text}"
                           BackgroundColor="{StaticResource input_color}"
                           IsVisible="{Binding IsInviteFormVisible}">
                        <Entry.Behaviors>
                            <toolkit:EmailValidationBehavior Flags="ValidateOnValueChanged"
                                                            InvalidStyle="{StaticResource InvalidEntryStyle}" />
                        </Entry.Behaviors>
                    </Entry>

                    <Label Text="Tipo de Colaborador"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{StaticResource primary_text_color}"/>

                    <VerticalStackLayout Spacing="10">
                        <Border Stroke="{StaticResource primary_orange_color}"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="#FFF5F0"
                                Padding="14,16">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding SelectedRole}"
                                             Value="Organização">
                                    <Setter Property="Stroke"
                                            Value="{StaticResource Gray100}"/>
                                    <Setter Property="BackgroundColor"
                                            Value="{StaticResource White}"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid ColumnDefinitions="Auto, *"
                                  ColumnSpacing="14">
                                <Border BackgroundColor="{StaticResource home_highlight_bg}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10"
                                        WidthRequest="42"
                                        HeightRequest="42"
                                        VerticalOptions="Center">
                                    <mi:MauiIcon Icon="{mi:Cupertino Person}"
                                                 IconSize="20"
                                                 IconColor="{StaticResource secondary_text_color}"
                                                 HorizontalOptions="Center"
                                                 VerticalOptions="Center"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1"
                                                     VerticalOptions="Center"
                                                     Spacing="2">
                                    <Label Text="Credenciamento"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource primary_text_color}"/>
                                    <Label Text="Check-in e portaria"
                                           FontSize="11"
                                           TextColor="{StaticResource secondary_text_color}"/>
                                </VerticalStackLayout>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleRoleCommand}"
                                                      CommandParameter="Credenciamento"/>
                            </Border.GestureRecognizers>
                        </Border>
                        <Border Stroke="{StaticResource Gray100}"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource White}"
                                Padding="14,16">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding SelectedRole}"
                                             Value="Organização">
                                    <Setter Property="Stroke"
                                            Value="{StaticResource primary_orange_color}"/>
                                    <Setter Property="BackgroundColor"
                                            Value="#FFF5F0"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid ColumnDefinitions="Auto, *"
                                  ColumnSpacing="14">
                                <Border BackgroundColor="{StaticResource card_icon_bg}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10"
                                        WidthRequest="42"
                                        HeightRequest="42"
                                        VerticalOptions="Center">
                                    <mi:MauiIcon Icon="{mi:Cupertino Shield}"
                                                 IconSize="20"
                                                 IconColor="{StaticResource secondary_text_color}"
                                                 HorizontalOptions="Center"
                                                 VerticalOptions="Center"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1"
                                                     VerticalOptions="Center"
                                                     Spacing="2">
                                    <Label Text="Organização"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource primary_text_color}"/>
                                    <Label Text="Outras funções do evento"
                                           FontSize="11"
                                           TextColor="{StaticResource secondary_text_color}"/>
                                </VerticalStackLayout>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleRoleCommand}"
                                                      CommandParameter="Organização"/>
                            </Border.GestureRecognizers>
                        </Border>
                    </VerticalStackLayout>

                    <Button TextColor="{StaticResource White}"
                            FontAttributes="Bold"
                            HeightRequest="46"
                            Background="{StaticResource gradient_button}"
                            Command="{Binding InviteCommand}"
                            CornerRadius="12">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button"
                                         Binding="{Binding IsEditingAccessLevel}"
                                         Value="False">
                                <Setter Property="Text"
                                        Value="Convidar"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Button"
                                         Binding="{Binding IsEditingAccessLevel}"
                                         Value="True">
                                <Setter Property="Text"
                                        Value="Salvar"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <Border Stroke="{StaticResource Gray300}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="{StaticResource White}"
                            Padding="14,10"
                            IsVisible="{Binding IsEditFormVisible}"
                            HorizontalOptions="Center">
                        <Label Text="Cancelar"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource secondary_text_color}"
                               HorizontalOptions="Center"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CancelEditAccessLevelCommand}"/>
                        </Border.GestureRecognizers>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Pending Invites Section -->
            <VerticalStackLayout Spacing="10">
                <Label FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{StaticResource primary_text_color}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Pendentes"/>
                            <Span Text="  "/>
                            <Span Text="{Binding PendingCount}"
                                  FontAttributes="None"
                                  TextColor="{StaticResource secondary_text_color}"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding PendingInvites}"
                                     Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:TeamMember">
                            <Border Stroke="{StaticResource Gray200}"
                                    StrokeThickness="1.5"
                                    StrokeDashArray="2,2"
                                    StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{StaticResource White}"
                                    Padding="12">
                                <Grid ColumnDefinitions="Auto, *, Auto"
                                      ColumnSpacing="12">
                                    <Border WidthRequest="40"
                                            HeightRequest="40"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 20"
                                            BackgroundColor="{StaticResource card_icon_bg}">
                                        <Label Text="{Binding Initial}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource primary_text_color}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1"
                                                         VerticalOptions="Center"
                                                         Spacing="2">
                                        <Label Text="{Binding Email}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource primary_text_color}"/>
                                        <Label Text="{Binding Role}"
                                               FontSize="11"
                                               TextColor="{StaticResource secondary_text_color}"/>
                                    </VerticalStackLayout>
                                    <Border Grid.Column="2"
                                            WidthRequest="36"
                                            HeightRequest="36"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 18"
                                            BackgroundColor="{StaticResource delete_bg}"
                                            VerticalOptions="Center">
                                        <mi:MauiIcon Icon="{mi:Cupertino Trash}"
                                                Style="{StaticResource ActionIcon}"
                                                IconSize="16"/>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.RemoveMemberCommand}"
                                                                  CommandParameter="{Binding}"/>
                                        </Border.GestureRecognizers>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Active Team Section -->
            <VerticalStackLayout Spacing="10">
                <Label FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{StaticResource primary_text_color}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Equipe Ativa"/>
                            <Span Text="  "/>
                            <Span Text="{Binding ActiveCount}"
                                  FontAttributes="None"
                                  TextColor="{StaticResource secondary_text_color}"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding ActiveTeam}"
                                     Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:TeamMember">
                            <Border Stroke="{StaticResource Gray100}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{StaticResource White}"
                                    Padding="12">
                                <Grid ColumnDefinitions="Auto, *, Auto, Auto"
                                      ColumnSpacing="12">
                                    <Border WidthRequest="40"
                                            HeightRequest="40"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 20"
                                            BackgroundColor="{StaticResource card_icon_bg}">
                                        <Label Text="{Binding Initial}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource primary_text_color}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1"
                                                         VerticalOptions="Center"
                                                         Spacing="2">
                                        <Label Text="{Binding Name}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource primary_text_color}"/>
                                        <Label Text="{Binding Email}"
                                               FontSize="11"
                                               TextColor="{StaticResource secondary_text_color}"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2"
                                                         VerticalOptions="Center"
                                                         HorizontalOptions="End"
                                                         Spacing="6">
                                        <Border Padding="8,2"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 8"
                                                BackgroundColor="#DBEAFE"
                                                HorizontalOptions="End">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border"
                                                             Binding="{Binding Role}"
                                                             Value="Organização">
                                                    <Setter Property="BackgroundColor"
                                                            Value="#F3F4F6"/>
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label Text="{Binding Role}"
                                                   FontSize="9"
                                                   FontAttributes="Bold"
                                                   TextColor="#2563EB">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label"
                                                                 Binding="{Binding Role}"
                                                                 Value="Organização">
                                                        <Setter Property="TextColor"
                                                                Value="#6B7280"/>
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>
                                    </VerticalStackLayout>
                                    <Border Grid.Column="3"
                                            WidthRequest="36"
                                            HeightRequest="36"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 18"
                                            BackgroundColor="{StaticResource card_icon_bg}"
                                            VerticalOptions="Center">
                                        <mi:MauiIcon Icon="{mi:Cupertino Pencil}"
                                                     Style="{StaticResource ActionIcon}"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"/>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.EditAccessLevelCommand}"
                                                                  CommandParameter="{Binding}"/>
                                        </Border.GestureRecognizers>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
