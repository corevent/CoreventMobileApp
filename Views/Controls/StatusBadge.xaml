<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CoreventApp.Views.Controls.StatusBadge"
             x:Name="ThisControl">
    <Border Padding="10,3"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 20"
            VerticalOptions="Start"
            BackgroundColor="{Binding BadgeBackgroundColor, Source={x:Reference ThisControl}}">
        <Label FontSize="11"
               FontAttributes="Bold"
               Text="{Binding Label, Source={x:Reference ThisControl}}"
               TextColor="{Binding LabelColor, Source={x:Reference ThisControl}}" />
    </Border>
</ContentView>
