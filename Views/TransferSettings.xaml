<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CoreventApp.ViewModels"
             x:Class="CoreventApp.Views.TransferSettings"
             x:Name="ThisPage"
             x:DataType="vm:TransferSettingsViewModel"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             Title="Configurações de Repasse"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource background_color}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing"
                                          BindingContext="{Binding Source={x:Reference ThisPage}, Path=BindingContext}"
                                          Command="{Binding LoadCommand}" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto, *">
        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto, *, Auto"
              Padding="16,14,16,10"
              VerticalOptions="Center">
            <Border Style="{StaticResource BackButtonContainer}">
                <mi:MauiIcon Icon="{mi:Cupertino ArrowLeft}"
                             Style="{StaticResource BackIcon}"/>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                </Border.GestureRecognizers>
            </Border>

            <Label Grid.Column="1"
                   Text="Configurações de Repasse"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{StaticResource primary_text_color}"
                   VerticalOptions="Center"
                   Margin="12,0,0,0"/>
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,14,16,20"
                                 Spacing="24">

                <!-- Info Banner -->
                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 18"
                        BackgroundColor="#F0F7FF"
                        Padding="16,14">
                    <Grid ColumnDefinitions="24, *" ColumnSpacing="12">
                        <mi:MauiIcon Icon="{mi:Cupertino InfoCircle}"
                                     Style="{StaticResource SmallIcon}"
                                     IconColor="{StaticResource icon_default_color}"/>
                        <Label Grid.Column="1"
                               Text="Seus repasses são automáticos. Mantenha os dados atualizados para evitar atrasos no recebimento das vendas."
                               FontSize="12"
                               TextColor="#1E88E5"
                               LineHeight="1.2"/>
                    </Grid>
                </Border>

                    <!-- Bank Accounts Section -->
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="CONTAS BANCÁRIAS"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource secondary_text_color}"
                               CharacterSpacing="1"/>
                        <Label Grid.Column="1"
                               Text="NOVA CONTA"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource primary_orange_color}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AddAccountCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding BankAccounts}" Spacing="12">
                        <BindableLayout.EmptyView>
                            <Label Text="Nenhuma conta cadastrada"
                                   FontSize="13"
                                   TextColor="{StaticResource secondary_text_color}"
                                   HorizontalOptions="Center"
                                   Margin="0,8"/>
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:BankAccountItem">
                                <Border Stroke="{StaticResource Gray100}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 22"
                                        BackgroundColor="{StaticResource White}"
                                        Padding="0">
                                    <Grid ColumnDefinitions="6, *">
                                        <BoxView Grid.Column="0" 
                                                 BackgroundColor="#E53935" 
                                                 CornerRadius="3,0,3,0"
                                                 WidthRequest="6"/>
                                        
                                        <Grid Grid.Column="1" ColumnDefinitions="60, *, Auto" Padding="12,16,16,16" ColumnSpacing="12">
                                            <Border Style="{StaticResource LargeMenuIconContainer}">
                                                <mi:MauiIcon Icon="{mi:Cupertino Creditcard}"
                                                             IconSize="22"
                                                             IconColor="{StaticResource primary_text_color}"
                                                             HorizontalOptions="Center"
                                                             VerticalOptions="Center"/>
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding Description}"
                                                       FontSize="15"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource primary_text_color}"/>
                                                <Label Text="{Binding DisplayText}"
                                                       FontSize="11"
                                                       TextColor="{StaticResource secondary_text_color}"/>
                                            </VerticalStackLayout>

                                            <mi:MauiIcon Grid.Column="2"
                                                         Icon="{mi:Cupertino Trash}"
                                                         Style="{StaticResource ActionIcon}"
                                                         IconSize="20">
                                                <mi:MauiIcon.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TransferSettingsViewModel}}, Path=DeleteBankAccountCommand}"
                                                                          CommandParameter="{Binding .}"/>
                                                </mi:MauiIcon.GestureRecognizers>
                                            </mi:MauiIcon>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Pix Keys Section -->
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="CHAVES PIX"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource secondary_text_color}"
                               CharacterSpacing="1"/>
                        <Label Grid.Column="1"
                               Text="ADICIONAR CHAVE"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource primary_orange_color}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AddPixKeyCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding PixKeys}" Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:PixKey">
                                <Border Stroke="{StaticResource Gray100}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 22"
                                        BackgroundColor="{StaticResource White}"
                                        Padding="16">
                                    <Grid ColumnDefinitions="48, *, Auto" ColumnSpacing="12">
                                        <Border BackgroundColor="{StaticResource card_icon_bg}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 12"
                                                WidthRequest="40"
                                                HeightRequest="40">
                                            <mi:MauiIcon Icon="{mi:Cupertino Qrcode}"
                                                         IconSize="18"
                                                         IconColor="{StaticResource primary_text_color}"
                                                         HorizontalOptions="Center"
                                                         VerticalOptions="Center"/>
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Key}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource primary_text_color}"/>
                                            <Label Text="{Binding Type}"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource secondary_text_color}"/>
                                        </VerticalStackLayout>

                                        <mi:MauiIcon Grid.Column="2"
                                                     Icon="{mi:Cupertino Trash}"
                                                     Style="{StaticResource ActionIcon}"
                                                     IconSize="20">
                                            <mi:MauiIcon.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TransferSettingsViewModel}}, Path=DeletePixKeyCommand}"
                                                                      CommandParameter="{Binding .}"/>
                                            </mi:MauiIcon.GestureRecognizers>
                                        </mi:MauiIcon>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Footer: Security -->
                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 30"
                        BackgroundColor="{StaticResource primary_text_color}"
                        Padding="24"
                        Margin="0,20,0,0">
                    <Grid RowDefinitions="Auto, Auto, Auto" RowSpacing="12">
                        <HorizontalStackLayout Spacing="8">
                            <BoxView Color="#4CAF50" WidthRequest="8" HeightRequest="8" CornerRadius="4" VerticalOptions="Center"/>
                            <Label Text="CONFORMIDADE FINANCEIRA" 
                                   FontSize="10" 
                                   FontAttributes="Bold" 
                                   TextColor="{StaticResource White}"
                                   CharacterSpacing="1"/>
                        </HorizontalStackLayout>

                        <Label Grid.Row="1"
                               Text="Segurança Máxima"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"/>

                        <Label Grid.Row="2"
                               Text="Suas informações bancárias são criptografadas e utilizadas exclusivamente para o repasse automatizado de suas vendas."
                               FontSize="12"
                               TextColor="{StaticResource White}"
                               Opacity="0.7"
                               LineHeight="1.3"/>
                        
                        <!-- Background Shield Watermark -->
                        <mi:MauiIcon Icon="{mi:Cupertino Shield}"
                                     Grid.RowSpan="3"
                                     HorizontalOptions="End"
                                     VerticalOptions="Center"
                                     IconSize="60"
                                     Opacity="0.1"
                                     IconColor="{StaticResource White}"/>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading Overlay -->
        <Grid IsVisible="{Binding IsLoading}"
              Grid.RowSpan="2"
              BackgroundColor="#80000000">
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               Color="{StaticResource primary_orange_color}"
                               HeightRequest="50"
                               WidthRequest="50"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
        </Grid>
    </Grid>
</ContentPage>
