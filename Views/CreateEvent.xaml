<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
              xmlns:vm="clr-namespace:CoreventApp.ViewModels"
              xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
              x:Class="CoreventApp.Views.CreateEvent"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             x:DataType="vm:CreateEventViewModel"
             Title="Criar Evento"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource background_color}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:CompareConverter x:Key="IsStep1" ComparisonOperator="Equal">
                <toolkit:CompareConverter.ComparingValue>
                    <x:Int32>1</x:Int32>
                </toolkit:CompareConverter.ComparingValue>
            </toolkit:CompareConverter>
            <toolkit:CompareConverter x:Key="IsStep2" ComparisonOperator="Equal">
                <toolkit:CompareConverter.ComparingValue>
                    <x:Int32>2</x:Int32>
                </toolkit:CompareConverter.ComparingValue>
            </toolkit:CompareConverter>
            <toolkit:CompareConverter x:Key="IsStep3" ComparisonOperator="Equal">
                <toolkit:CompareConverter.ComparingValue>
                    <x:Int32>3</x:Int32>
                </toolkit:CompareConverter.ComparingValue>
            </toolkit:CompareConverter>
            <toolkit:IsStringNotNullOrEmptyConverter x:Key="NotNullConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid BackgroundColor="{StaticResource background_color}">
        <Grid RowDefinitions="Auto, Auto, Auto, *, Auto"
              Padding="20">

        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto, *, Auto"
              VerticalOptions="Center">
            <Border Style="{StaticResource BackButtonContainer}">
                <mi:MauiIcon Icon="{mi:Cupertino ArrowLeft}" Style="{StaticResource BackIcon}"/>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BackCommand}"/>
                </Border.GestureRecognizers>
            </Border>
             <Label Grid.Column="1"
                   Text="{Binding PageTitle}"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{StaticResource primary_text_color}"
                   VerticalOptions="Center"
                   Margin="12,0,0,0"/>
        </Grid>

        <!-- Progress Bar -->
        <ProgressBar Grid.Row="1"
                     Margin="0,20,0,30"
                     Progress="{Binding Progress}"
                     HeightRequest="8"
                     BackgroundColor="{StaticResource Gray100}"
                     ProgressColor="{StaticResource primary_orange_color}"/>

        <!-- Step Title & Description -->
        <VerticalStackLayout Grid.Row="2"
                             Margin="0,0,0,6"
                             Spacing="5">
            <Label Text="{Binding StepTitle}"
                   FontSize="22"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   HorizontalOptions="Start"
                   TextColor="{StaticResource primary_text_color}"/>
            <Label Text="{Binding StepDescription}"
                   VerticalOptions="Center"
                   HorizontalOptions="Start"
                   TextColor="{StaticResource secondary_text_color}"/>
        </VerticalStackLayout>

        <!-- Content Area -->
        <ScrollView Grid.Row="3"
                    Margin="0,4,0,0">
            <Grid RowDefinitions="*">

                <!-- Step 1: Basic Info -->
                <VerticalStackLayout IsVisible="{Binding CurrentStep, Converter={StaticResource IsStep1}}"
                                     Spacing="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Título do Evento"
                               TextColor="{StaticResource primary_text_color}"/>
                        <Entry Text="{Binding Form.Title}"
                               IsEnabled="{Binding IsEditable}"
                               Placeholder="Ex: Festival de Verão"
                               TextColor="{StaticResource input_text}"
                               BackgroundColor="{StaticResource input_color}"/>
                        <Label Text="{Binding Form.TitleError}"
                               TextColor="{StaticResource error_color}"
                               FontSize="12"
                               IsVisible="{Binding Form.TitleError, Converter={StaticResource NotNullConverter}}"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Descrição"
                               TextColor="{StaticResource primary_text_color}"/>
                        <Editor Text="{Binding Form.Description}"
                                IsEnabled="{Binding IsEditable}"
                                Placeholder="Descreva seu evento..."
                                HeightRequest="100"
                                TextColor="{StaticResource input_text}"
                                BackgroundColor="{StaticResource input_color}"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Categoria"
                               TextColor="{StaticResource primary_text_color}"/>
                        <Border Stroke="{StaticResource Gray100}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="{StaticResource input_color}"
                                Padding="4,0">
                            <Picker ItemsSource="{Binding Categories}"
                                    IsEnabled="{Binding IsEditable}"
                                    SelectedItem="{Binding Form.Category}"
                                    Title="Selecione uma categoria"
                                    TextColor="{StaticResource input_text}"
                                    BackgroundColor="Transparent"/>
                        </Border>
                    </VerticalStackLayout>
                    <!-- Banner -->
                    <Border Stroke="{StaticResource Gray100}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14"
                            BackgroundColor="{StaticResource Gray50}"
                            Padding="0"
                            HeightRequest="160">
                        <Grid>
                            <Image Source="{Binding Form.BannerPreview}"
                                   Aspect="AspectFill"
                                   HeightRequest="160"/>
                            <VerticalStackLayout VerticalOptions="Center"
                                                 HorizontalOptions="Center"
                                                 Spacing="4">
                                <mi:MauiIcon Icon="{mi:Cupertino PhotoonRectangle}"
                                             IconSize="32"
                                             IconColor="{StaticResource Gray300}"
                                             HorizontalOptions="Center"/>
                                <Label Text="Adicionar Banner"
                                       FontSize="14"
                                       TextColor="{StaticResource Gray300}"
                                       HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PickBannerCommand}"/>
                            </Border.GestureRecognizers>
                        </Grid>
                    </Border>

                    <HorizontalStackLayout Spacing="12"
                                           Margin="0,4,0,0">
                        <Switch IsToggled="{Binding Form.IsOver18}"
                                IsEnabled="{Binding IsEditable}"
                                OnColor="{StaticResource primary_orange_color}"
                                ThumbColor="{StaticResource Gray200}"/>
                        <Label Text="Evento para maiores de 18 anos"
                               VerticalOptions="Center"
                               TextColor="{StaticResource primary_text_color}"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Step 2: Date & Participation -->
                <VerticalStackLayout IsVisible="{Binding CurrentStep, Converter={StaticResource IsStep2}}"
                                     Spacing="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Data de início"
                               TextColor="{StaticResource primary_text_color}"/>
                        <DatePicker Date="{Binding Form.StartDate}"
                                    IsEnabled="{Binding IsEditable}"
                                    MinimumDate="{Binding StartDateMinimum}"
                                    Format="dd/MM/yyyy"
                                    TextColor="{StaticResource primary_text_color}"
                                    BackgroundColor="{StaticResource input_color}"/>
                        <Label Text="{Binding Form.StartDateError}"
                               TextColor="{StaticResource error_color}"
                               FontSize="12"
                               IsVisible="{Binding Form.StartDateError, Converter={StaticResource NotNullConverter}}"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Data de término"
                               TextColor="{StaticResource primary_text_color}"/>
                        <DatePicker Date="{Binding Form.EndDate}"
                                    IsEnabled="{Binding IsEditable}"
                                    MinimumDate="{Binding Form.StartDate}"
                                    Format="dd/MM/yyyy"
                                    TextColor="{StaticResource primary_text_color}"
                                    BackgroundColor="{StaticResource input_color}"/>
                        <Label Text="{Binding Form.EndDateError}"
                               TextColor="{StaticResource error_color}"
                               FontSize="12"
                               IsVisible="{Binding Form.EndDateError, Converter={StaticResource NotNullConverter}}"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Número máximo de participantes"
                               TextColor="{StaticResource primary_text_color}"/>
                        <Entry Text="{Binding Form.MaxParticipants}"
                               IsEnabled="{Binding IsEditable}"
                               Placeholder="Ex: 500"
                               Keyboard="Numeric"
                               TextColor="{StaticResource input_text}"
                               BackgroundColor="{StaticResource input_color}"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Step 3: Location -->
                <VerticalStackLayout IsVisible="{Binding CurrentStep, Converter={StaticResource IsStep3}}"
                                     Spacing="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Tipo de localização"
                               TextColor="{StaticResource primary_text_color}"/>
                        <Border Stroke="{StaticResource Gray100}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="{StaticResource input_color}"
                                Padding="4,0">
                            <Picker ItemsSource="{Binding LocationTypes}"
                                    IsEnabled="{Binding IsEditable}"
                                    SelectedItem="{Binding Form.LocationType}"
                                    TextColor="{StaticResource input_text}"
                                    BackgroundColor="Transparent"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Location fields (Presencial / Híbrido only) -->
                    <VerticalStackLayout Spacing="16"
                                         IsVisible="{Binding Form.IsPhysicalLocationVisible}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Nome do local"
                                   TextColor="{StaticResource primary_text_color}"/>
                            <Entry Text="{Binding Form.LocationName}"
                                   IsEnabled="{Binding IsEditable}"
                                   Placeholder="Ex: Parque Ibirapuera"
                                   TextColor="{StaticResource input_text}"
                                   BackgroundColor="{StaticResource input_color}"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Estado"
                                   TextColor="{StaticResource primary_text_color}"/>
                            <Border Stroke="{StaticResource Gray100}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    BackgroundColor="{StaticResource input_color}"
                                    Padding="4,0">
                                <Picker x:Name="StatePicker"
                                        ItemsSource="{Binding Form.States}"
                                        IsEnabled="{Binding IsEditable}"
                                        SelectedIndex="{Binding Form.SelectedStateIndex}"
                                        ItemDisplayBinding="{Binding Name}"
                                        Title="Selecione o estado"
                                        TextColor="{StaticResource input_text}"
                                        BackgroundColor="Transparent"/>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Cidade"
                                   TextColor="{StaticResource primary_text_color}"/>
                            <Border Stroke="{StaticResource Gray100}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    BackgroundColor="{StaticResource input_color}"
                                    Padding="4,0">
                                <Picker ItemsSource="{Binding Form.Cities}"
                                        IsEnabled="{Binding IsEditable}"
                                        SelectedIndex="{Binding Form.SelectedCityIndex}"
                                        ItemDisplayBinding="{Binding Name}"
                                        Title="Selecione a cidade"
                                        TextColor="{StaticResource input_text}"
                                        BackgroundColor="Transparent"/>
                            </Border>
                        </VerticalStackLayout>
                        <Grid ColumnDefinitions="*, *"
                              ColumnSpacing="12">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="CEP"
                                       TextColor="{StaticResource primary_text_color}"/>
                                <Entry Text="{Binding Form.ZipCode}"
                                       IsEnabled="{Binding IsEditable}"
                                       Placeholder="00000-000"
                                       Keyboard="Numeric"
                                       MaxLength="9"
                                       TextColor="{StaticResource input_text}"
                                       BackgroundColor="{StaticResource input_color}"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="6">
                                <Label Text="Bairro"
                                       TextColor="{StaticResource primary_text_color}"/>
                                <Entry Text="{Binding Form.Neighborhood}"
                                       IsEnabled="{Binding IsEditable}"
                                       Placeholder="Ex: Vila Mariana"
                                       TextColor="{StaticResource input_text}"
                                       BackgroundColor="{StaticResource input_color}"/>
                            </VerticalStackLayout>
                        </Grid>
                        <Grid ColumnDefinitions="*, Auto"
                              ColumnSpacing="12">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Rua"
                                       TextColor="{StaticResource primary_text_color}"/>
                                <Entry Text="{Binding Form.Street}"
                                       IsEnabled="{Binding IsEditable}"
                                       Placeholder="Ex: Av. Paulista"
                                       TextColor="{StaticResource input_text}"
                                       BackgroundColor="{StaticResource input_color}"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="6"
                                                 WidthRequest="80">
                                <Label Text="Número"
                                       TextColor="{StaticResource primary_text_color}"/>
                                <Entry Text="{Binding Form.Number}"
                                       IsEnabled="{Binding IsEditable}"
                                       Placeholder="123"
                                       Keyboard="Numeric"
                                       TextColor="{StaticResource input_text}"
                                       BackgroundColor="{StaticResource input_color}"/>
                            </VerticalStackLayout>
                        </Grid>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Complemento"
                                   TextColor="{StaticResource primary_text_color}"/>
                            <Entry Text="{Binding Form.Complement}"
                                   IsEnabled="{Binding IsEditable}"
                                   Placeholder="Ex: Sala 42"
                                   TextColor="{StaticResource input_text}"
                                   BackgroundColor="{StaticResource input_color}"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <Label Text="{Binding Form.AddressError}"
                           TextColor="{StaticResource error_color}"
                           FontSize="12"
                            IsVisible="{Binding Form.AddressError, Converter={StaticResource NotNullConverter}}"/>
                </VerticalStackLayout>

            </Grid>
        </ScrollView>

        <!-- Bottom Buttons -->
        <VerticalStackLayout Grid.Row="4"
                             VerticalOptions="End"
                             Spacing="12"
                             Margin="0,16,0,0">

            <!-- Next button (steps 1-2) -->
            <Button Text="{Binding ButtonNextText}"
                    TextColor="{StaticResource White}"
                    FontAttributes="Bold"
                    HeightRequest="48"
                    Background="{StaticResource gradient_button}"
                    Command="{Binding NextCommand}"
                    IsVisible="{Binding CurrentStep, Converter={StaticResource IsStep1}}"/>

            <Button Text="{Binding ButtonNextText}"
                    TextColor="{StaticResource White}"
                    FontAttributes="Bold"
                    HeightRequest="48"
                    Background="{StaticResource gradient_button}"
                    Command="{Binding NextCommand}"
                    IsVisible="{Binding CurrentStep, Converter={StaticResource IsStep2}}"/>

            <!-- Step 3: Draft / Publish -->
            <VerticalStackLayout IsVisible="{Binding CurrentStep, Converter={StaticResource IsStep3}}"
                                 Spacing="12">
                <Button Text="{Binding DraftButtonText}"
                        TextColor="{StaticResource White}"
                        FontAttributes="Bold"
                        HeightRequest="48"
                        Background="{StaticResource gradient_button}"
                        Command="{Binding SaveDraftCommand}"
                        IsVisible="{Binding ShowDraftButton}"/>

                <Button Text="Publicar Evento"
                        TextColor="{StaticResource purchase_btn_bg}"
                        FontAttributes="Bold"
                        HeightRequest="48"
                        BackgroundColor="{StaticResource White}"
                        BorderColor="{StaticResource purchase_btn_bg}"
                        BorderWidth="1"
                        CornerRadius="12"
                        Command="{Binding PublishEventCommand}"
                        IsVisible="{Binding ShowPublishButton}"/>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </Grid>

    <!-- Loading Overlay -->
    <Grid IsVisible="{Binding IsUploadingBanner}"
          BackgroundColor="#80000000"
          InputTransparent="False">
        <VerticalStackLayout VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="12">
            <ActivityIndicator IsRunning="{Binding IsUploadingBanner}"
                               Color="{StaticResource White}"
                               HeightRequest="48"
                               WidthRequest="48"/>
            <Label Text="Enviando banner..."
                   TextColor="{StaticResource White}"
                   FontSize="16"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"/>
        </VerticalStackLayout>
    </Grid>
</Grid>
</ContentPage>
