<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CoreventApp.ViewModels"
             xmlns:dtos="clr-namespace:CoreventApp.Models.Dtos"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="CoreventApp.Views.Explore"
             x:DataType="vm:ExploreViewModel"
             x:Name="ThisPage"
             Title="Explorar"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource background_color}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing"
                                          BindingContext="{Binding Source={x:Reference ThisPage}, Path=BindingContext}"
                                          Command="{Binding SearchCommand}" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto, Auto, *">

        <!-- Row 0: Search -->
        <Grid Grid.Row="0"
              Padding="16,14,16,10">
            <Border Stroke="{StaticResource Gray100}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="{StaticResource White}"
                    Padding="12,8">
                <Grid ColumnDefinitions="Auto, *"
                      ColumnSpacing="8">
                    <Border BackgroundColor="{StaticResource card_icon_bg}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 10"
                            WidthRequest="28"
                            HeightRequest="28"
                            VerticalOptions="Center">
                        <mi:MauiIcon Icon="{mi:Cupertino Search}"
                                     IconSize="14"
                                     IconColor="{StaticResource icon_default_color}"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"/>
                    </Border>
                    <Entry Grid.Column="1"
                           Placeholder="Buscar eventos..."
                           PlaceholderColor="{StaticResource secondary_text_color}"
                           Text="{Binding SearchText}"
                           FontSize="14"
                           VerticalOptions="Center"
                           TextColor="{StaticResource primary_text_color}"
                           BackgroundColor="Transparent"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Row 1: Category Chips -->
        <ScrollView Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    Margin="16,0,16,0">
            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Categories}"
                                   Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoryItem">
                        <Border HeightRequest="36"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18"
                                Padding="14,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BackgroundColor"
                                            Value="{StaticResource White}"/>
                                    <Setter Property="Stroke"
                                            Value="{StaticResource Gray100}"/>
                                    <Style.Triggers>
                                        <DataTrigger TargetType="Border"
                                                Binding="{Binding IsSelected}"
                                                Value="True">
                                            <Setter Property="BackgroundColor"
                                                    Value="{StaticResource primary_orange_color}"/>
                                            <Setter Property="Stroke"
                                                    Value="{StaticResource primary_orange_color}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Label Text="{Binding Name}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center">
                                <Label.Style>
                                    <Style TargetType="Label">
                                        <Setter Property="TextColor"
                                                Value="{StaticResource secondary_text_color}"/>
                                        <Style.Triggers>
                                            <DataTrigger TargetType="Label"
                                                    Binding="{Binding IsSelected}"
                                                    Value="True">
                                                <Setter Property="TextColor"
                                                        Value="{StaticResource White}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Label.Style>
                            </Label>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectCategoryCommand}"
                                    CommandParameter="{Binding}"/>
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Row 2: Events List -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Events}"
                        RemainingItemsThreshold="2"
                        RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                        Margin="16,14,16,20">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical"
                        ItemSpacing="14"/>
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Padding="40">
                    <Label Text="Nenhum evento encontrado"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource secondary_text_color}"
                           HorizontalOptions="Center"/>
                    <Label Text="Tente buscar por outra categoria ou termo"
                           FontSize="13"
                           TextColor="{StaticResource secondary_text_color}"
                           HorizontalOptions="Center"
                           Margin="0,8,0,0"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dtos:EventListItemDto">
                    <Border Stroke="{StaticResource Gray100}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20"
                            BackgroundColor="{StaticResource White}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectEventCommand}"
                                CommandParameter="{Binding}"/>
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="100, *" Padding="8, 6">
                            <Border WidthRequest="100"
                                    HeightRequest="100"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 20,18">
                                <Image Source="{Binding BannerUrl, TargetNullValue='https://placehold.co/200x200/FF5722/FFFFFF.png?text=Evento'}"
                                       Aspect="AspectFill"/>
                            </Border>

                            <VerticalStackLayout Grid.Column="1"
                                                 Padding="12,10,12,10"
                                                 Spacing="3"
                                                 VerticalOptions="Center">
                                <Label Text="{Binding Category, Converter={StaticResource CategoryDisplayConverter}}"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource secondary_text_color}"/>

                                <Label Text="{Binding Title}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource primary_text_color}"
                                       LineBreakMode="TailTruncation"/>

                                <HorizontalStackLayout Spacing="4">
                                    <mi:MauiIcon Icon="{mi:Cupertino MapPin}"
                                                 IconSize="11"
                                                 IconColor="{StaticResource icon_default_color}"
                                                 VerticalOptions="Center"/>
                                    <Label Text="{Binding LocationName}"
                                           FontSize="11"
                                           TextColor="{StaticResource secondary_text_color}"
                                           LineBreakMode="TailTruncation"
                                           VerticalOptions="Center"/>
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Spacing="4">
                                    <mi:MauiIcon Icon="{mi:Cupertino Calendar}"
                                                 IconSize="11"
                                                 IconColor="{StaticResource icon_default_color}"
                                                 VerticalOptions="Center"/>
                                    <Label Text="{Binding StartDate, StringFormat='{0:dd MMM, yyyy}'}"
                                           FontSize="11"
                                           TextColor="{StaticResource secondary_text_color}"
                                           VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
